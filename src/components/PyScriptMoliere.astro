---
// Live, in-browser Python demo (PyScript / Pyodide) that mirrors the
// tutorial's final whole-file sed script: it loops over every line,
// rewrites each nine-word sentence into the philosophy teacher's five
// phrasings, and flags any line that isn't the right shape.
// Self-contained: loads its own PyScript runtime and fonts; styles are
// namespaced under `.pysd` so nothing leaks into the surrounding docs page.
interface Props {
  lang?: "en" | "fr";
}

const { lang = "en" } = Astro.props;

const strings = {
  en: {
    eyebrow: "PyScript · executing in your browser",
    title: "This page is running Python.",
    sub: "No server, no install. Python loops over every line you give it — the way the tutorial's final script runs across a whole file — rewriting each nine-word sentence into the philosophy teacher's five phrasings, and flagging any line that isn't the right shape.",
    booting: "Booting the Python interpreter…",
    inputLabel: "Your sentences — one per line, nine words each",
    runButton: "Rephrase every line",
    outputLabel: "Output from Python",
    outputEmpty: "Click the button to run.",
    buildBadge:
      "BUILD v3 · deterministic permutations (no random shuffle) · first output line should be the original sentence",
    foot: "The runtime is fetched on first load, so the dot stays amber for a few seconds while genuine CPython boots in your browser. The last sample line has only two words, so Python flags it instead of rephrasing it — everything runs client-side, no server involved.",
    typeAtLeastOne: "Type at least one sentence.",
    flagText: "skipped &mdash; {n} words, needs 9",
  },
  fr: {
    eyebrow: "PyScript · exécution dans votre navigateur",
    title: "Cette page exécute du Python.",
    sub: "Pas de serveur, pas d'installation. Python parcourt chaque ligne que vous lui donnez — comme le script final du tutoriel s'exécute sur tout un fichier — et réécrit chaque phrase de neuf mots selon les cinq formulations du maître de philosophie, en signalant toute ligne qui n'a pas la bonne forme.",
    booting: "Démarrage de l'interpréteur Python…",
    inputLabel: "Vos phrases — une par ligne, neuf mots chacune",
    runButton: "Reformuler chaque ligne",
    outputLabel: "Sortie de Python",
    outputEmpty: "Cliquez sur le bouton pour exécuter.",
    buildBadge:
      "BUILD v3 · permutations déterministes (sans mélange aléatoire) · la première ligne de sortie doit être la phrase d'origine",
    foot: "Le runtime est téléchargé au premier chargement : le point reste ambre quelques secondes, le temps que CPython démarre dans votre navigateur. La dernière ligne d'exemple ne compte que deux mots : Python la signale au lieu de la reformuler — tout s'exécute côté client, sans serveur.",
    typeAtLeastOne: "Saisissez au moins une phrase.",
    flagText: "ignorée &mdash; {n} mots, il en faut 9",
  },
}[lang];

const defaultSentences = [
  "Belle marquise, vos beaux yeux me font mourir d'amour.",
  "Cher docteur, ces grands malheurs vous font pleurer d'amertume.",
  "Petit garçon, cette bonne glace te fait saliver d'envie.",
  "Vaste océan, la forte houle te fait tanguer d'ivresse.",
  "Phrase incomplète.",
].join("\n");

// The real, executed Python. Localized user-facing strings are interpolated;
// `{n}`, `{src}` etc. are Python f-string fields and stay literal in JS.
const pyRun = `from pyscript import when, document
import sys, html

PATTERNS = [
    [1, 2, ",", 3, 4, 5, 6, 7, 8, 9],
    [9, 8, 6, 7, ",", 1, 2, ",", 3, 4, 5],
    [3, 5, 4, 9, 6, 7, ",", 1, 2, ",", 8],
    [8, 3, 4, 5, ",", 1, 2, ",", 9, 6, 7],
    [6, 7, 3, 5, 4, 8, ",", 1, 2, ",", 9],
]

def reorder(words, pattern):
    parts = []
    for token in pattern:
        if token == ",":
            parts[-1] += ","
        else:
            parts.append(words[token - 1])
    line = " ".join(parts)
    return line[0].upper() + line[1:] + "."

def process(sentence):
    words = [w.strip(",.").lower() for w in sentence.split()]
    if len(words) != 9:
        return None, len(words)
    return [reorder(words, p) for p in PATTERNS], 9

@when("click", "#run")
def run(event):
    raw = str(document.querySelector("#input").value)
    box = document.querySelector("#output")
    sentences = [ln.strip() for ln in raw.splitlines() if ln.strip()]
    if not sentences:
        box.innerHTML = '<span class="empty">${strings.typeAtLeastOne}</span>'
        return
    blocks = []
    for sentence in sentences:
        variants, n = process(sentence)
        src = html.escape(sentence)
        if variants is None:
            blocks.append(
                f'<div class="block bad"><div class="src">{src}</div>'
                f'<div class="flag">${strings.flagText}</div></div>'
            )
        else:
            lines = "".join(f'<div class="line">{html.escape(v)}</div>' for v in variants)
            blocks.append(f'<div class="block"><div class="src">{src}</div>{lines}</div>')
    box.innerHTML = "".join(blocks)

# Runs once the interpreter is ready — confirms genuine CPython has loaded.
document.querySelector("#status").innerText = (
    "Python ready · " + sys.version.split()[0] + " (CPython via Pyodide)"
)`;
---

<!-- PyScript runtime (left untouched by Astro via is:inline). -->
<link
  rel="stylesheet"
  href="https://pyscript.net/releases/2026.6.2/core.css"
/>
<script
  type="module"
  is:inline
  src="https://pyscript.net/releases/2026.6.2/core.js"></script>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;600&display=swap"
  rel="stylesheet"
/>

<div class="pysd">
  <header>
    <p class="eyebrow">{strings.eyebrow}</p>
    <div class="pysd-title">{strings.title}</div>
    <p class="sub">{strings.sub}</p>
    <div class="status">
      <span class="dot"></span><span id="status">{strings.booting}</span>
    </div>
    <p class="build-badge">{strings.buildBadge}</p>
  </header>

  <div class="card">
    <label for="input">{strings.inputLabel}</label>
    <textarea id="input">{defaultSentences}</textarea>
    <button id="run" type="button">{strings.runButton}</button>
  </div>

  <div class="card">
    <label>{strings.outputLabel}</label>
    <div id="output"><span class="empty">{strings.outputEmpty}</span></div>
  </div>

  <p class="foot">{strings.foot}</p>
</div>

<!-- The real, running Python. type="py" = Pyodide (full CPython). -->
<script type="py" is:inline set:html={pyRun}></script>

<style is:global>
  .pysd {
    --pysd-surface: #ffffff;
    --pysd-ink: #15223b;
    --pysd-muted: #5a6a84;
    --pysd-accent: #2f6fed;
    --pysd-live: #e0a800;
    --pysd-line: #d5dce7;
    --pysd-flag: #b26a00;

    background: #e7ebf1;
    color: var(--pysd-ink);
    font-family: "Inter", system-ui, sans-serif;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    border: 1px solid var(--pysd-line);
    border-radius: 16px;
    padding: 28px 24px 32px;
    margin: 2rem 0;
  }
  .pysd * {
    box-sizing: border-box;
  }
  .pysd .eyebrow {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pysd-accent);
    margin: 0 0 10px;
  }
  .pysd .pysd-title {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 4vw, 34px);
    line-height: 1.05;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
    color: var(--pysd-ink);
  }
  .pysd .sub {
    margin: 0;
    color: var(--pysd-muted);
    max-width: 58ch;
  }
  .pysd .sub code {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.9em;
  }
  .pysd .status {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 18px;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    color: var(--pysd-muted);
  }
  .pysd .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--pysd-live);
    box-shadow: 0 0 0 0 rgba(224, 168, 0, 0.55);
    animation: pysd-pulse 1.6s infinite;
  }
  @keyframes pysd-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(224, 168, 0, 0.55);
    }
    70% {
      box-shadow: 0 0 0 9px rgba(224, 168, 0, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(224, 168, 0, 0);
    }
  }
  .pysd .build-badge {
    margin: 10px 0 0;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--pysd-accent);
  }
  .pysd .card {
    background: var(--pysd-surface);
    border: 1px solid var(--pysd-line);
    border-radius: 14px;
    padding: 22px;
    margin-top: 18px;
  }
  .pysd label {
    display: block;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pysd-muted);
    margin-bottom: 10px;
  }
  .pysd textarea {
    width: 100%;
    min-height: 128px;
    resize: vertical;
    padding: 12px 14px;
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    color: var(--pysd-ink);
    border: 1px solid var(--pysd-line);
    border-radius: 9px;
    background: #fbfcfe;
    line-height: 1.7;
  }
  .pysd textarea:focus {
    outline: 2px solid var(--pysd-accent);
    outline-offset: 1px;
    border-color: transparent;
  }
  .pysd button {
    margin-top: 14px;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 500;
    font-size: 15px;
    color: #fff;
    background: var(--pysd-accent);
    border: none;
    border-radius: 9px;
    padding: 11px 22px;
    cursor: pointer;
    transition:
      transform 0.06s ease,
      background 0.15s ease;
  }
  .pysd button:hover {
    background: #235ed1;
  }
  .pysd button:active {
    transform: translateY(1px);
  }
  .pysd button:focus-visible {
    outline: 2px solid var(--pysd-ink);
    outline-offset: 2px;
  }
  .pysd #output {
    min-height: 24px;
  }
  .pysd #output .empty {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    color: var(--pysd-muted);
  }
  .pysd .block {
    padding: 14px 0;
    border-top: 1px solid var(--pysd-line);
  }
  .pysd .block:first-child {
    border-top: none;
    padding-top: 0;
  }
  .pysd .src {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--pysd-muted);
    margin-bottom: 9px;
  }
  .pysd .src::before {
    content: "\203A\00a0";
    color: var(--pysd-accent);
  }
  .pysd .line {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    line-height: 1.85;
    color: var(--pysd-ink);
  }
  .pysd .block.bad .src {
    color: #9aa6ba;
  }
  .pysd .flag {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--pysd-flag);
  }
  .pysd .foot {
    margin-top: 26px;
    margin-bottom: 0;
    font-size: 13px;
    color: var(--pysd-muted);
  }
  .pysd .foot code {
    font-family: "JetBrains Mono", monospace;
    background: #fff;
    border: 1px solid var(--pysd-line);
    padding: 1px 6px;
    border-radius: 5px;
  }
  @media (prefers-reduced-motion: reduce) {
    .pysd .dot {
      animation: none;
    }
  }
</style>
