---
interface Props {
  lang?: string;
}

const routeLang = (Astro.locals as Record<string, any>)?.starlightRoute?.lang;
const lang = Astro.props.lang || routeLang || 'en';
const isFr = lang === 'fr';

// The six sections of the manual, in reading order: topic → purpose → action.
const steps = isFr ? [
  { title: 'Comprendre la documentation', href: '/fr/learn/', desc: 'Pourquoi l’architecture documentaire compte : valeur, maturité, types d’information.', action: 'Lire les fondamentaux' },
  { title: 'Construire un processus documentaire', href: '/fr/process/', desc: 'Le processus étape par étape, de la définition du projet à la livraison.', action: 'Suivre le processus' },
  { title: 'Adopter le docs-as-code', href: '/fr/docs-as-code/', desc: 'Git, conception du référentiel, branches, CI/CD et contrôles automatisés.', action: 'Découvrir le workflow' },
  { title: 'Choisir un modèle de rédaction', href: '/fr/tools-and-formats/', desc: 'Rédaction structurée, DITA, Markdown, réutilisation du contenu et formats.', action: 'Comparer les modèles' },
  { title: 'Constituer votre boîte à outils', href: '/fr/toolkit/', desc: 'Modèles, check-lists et exemples concrets à réutiliser.', action: 'Ouvrir la boîte à outils' },
  { title: 'Automatisation et techniques spécialisées', href: '/fr/tutorials/', desc: 'Jinja, Python, sed, Sphinx/ReST, XSL-FO : techniques spécialisées et historiques.', action: 'Explorer les techniques' },
] : [
  { title: 'Understand documentation', href: '/en/learn/', desc: 'Why documentation architecture matters: value, maturity, information types.', action: 'Read the foundations' },
  { title: 'Build a documentation process', href: '/en/process/', desc: 'The workflow step by step, from project definition to delivery.', action: 'Follow the process' },
  { title: 'Adopt docs-as-code', href: '/en/docs-as-code/', desc: 'Git, repository design, branches, CI/CD, and automated checks.', action: 'Learn the workflow' },
  { title: 'Choose an authoring model', href: '/en/tools-and-formats/', desc: 'Structured authoring, DITA, Markdown, content reuse, and formats.', action: 'Compare the models' },
  { title: 'Build your toolkit', href: '/en/toolkit/', desc: 'Templates, checklists, and worked examples to reuse.', action: 'Open the toolkit' },
  { title: 'Automation & legacy techniques', href: '/en/tutorials/', desc: 'Jinja, Python, sed, Sphinx/ReST, XSL-FO: specialist and historical techniques.', action: 'Explore the techniques' },
];
---

<section class="start-here-panel not-content" id="six-paths" aria-labelledby="six-paths-heading">
  <div class="start-here-header">
    <p class="start-here-kicker">{isFr ? 'Parcours guidé' : 'Guided reading'}</p>
    <h2 id="six-paths-heading" class="start-here-title">
      {isFr ? 'Six parcours dans le manuel' : 'Six paths through the manual'}
    </h2>
    <p class="start-here-desc">
      {isFr
        ? 'Lisez-les dans l’ordre pour une méthode complète, ou allez directement au parcours dont vous avez besoin.'
        : 'Read them in order for a complete method, or go straight to the path you need.'}
    </p>
  </div>

  <ol class="start-here-sequence">
    {steps.map((step, index) => (
      <li class="start-here-item">
        <span class="start-here-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <div class="start-here-content">
          <h3 class="start-here-step-title"><a href={step.href}>{step.title}</a></h3>
          <p class="start-here-step-desc">{step.desc}</p>
        </div>
        <span class="start-here-action" aria-hidden="true">{step.action} →</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .start-here-panel {
    margin: 0 0 3.5rem 0;
    padding: 1.5rem 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .start-here-header {
    margin-bottom: 1.25rem;
  }

  .start-here-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-link);
    margin: 0 0 0.35rem 0;
  }

  .start-here-title {
    font-size: clamp(1.25rem, calc(1rem + 1vw), 1.6rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.25;
    margin: 0 0 0.5rem 0;
  }

  .start-here-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .start-here-sequence {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Each row is a list item; the title link is stretched over the row. */
  .start-here-item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0.85rem 1.15rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s ease;
  }

  .start-here-item:hover {
    border-color: var(--color-accent);
  }

  .start-here-item:has(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .start-here-step-title a:focus-visible {
    outline: none;
  }

  .start-here-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-link);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
  }

  .start-here-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .start-here-step-title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
  }

  .start-here-step-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .start-here-step-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .start-here-item:hover .start-here-step-title a {
    color: var(--color-link);
  }

  .start-here-step-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin: 0;
  }

  .start-here-action {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-link);
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .start-here-panel {
      padding: 1.25rem 1rem;
    }
    .start-here-item {
      grid-template-columns: auto 1fr;
      gap: 0.35rem 0.75rem;
      padding: 0.75rem;
    }
    .start-here-num {
      align-self: start;
      margin-top: 0.1rem;
    }
    .start-here-action {
      grid-column: 2;
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .start-here-item {
      transition: none !important;
    }
  }
</style>
