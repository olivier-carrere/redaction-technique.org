---
interface Props {
  lang?: string;
}

const routeLang = (Astro.locals as Record<string, any>)?.starlightRoute?.lang;
const lang = Astro.props.lang || routeLang || 'en';
const isFr = lang === 'fr';

const steps = isFr ? [
  {
    num: '01',
    title: 'Comprendre la documentation',
    href: '/fr/learn/',
    desc: 'Valeur de la documentation, maturité documentaire, rédaction et communication technique, typologie de l’information.',
  },
  {
    num: '02',
    title: 'Construire un processus documentaire',
    href: '/fr/process/',
    desc: 'Définir, collecter, tester, rédiger, valider, traduire et livrer — dans l’ordre où le travail se déroule.',
  },
  {
    num: '03',
    title: 'Adopter le docs-as-code',
    href: '/fr/docs-as-code/',
    desc: 'Traiter la documentation comme du code : cadence de livraison, contrôle de versions et intégration continue.',
  },
  {
    num: '04',
    title: 'Choisir un modèle de rédaction',
    href: '/fr/tools-and-formats/',
    desc: 'Markdown, rédaction structurée, DITA, réutilisation de contenu, formats source et cible.',
  },
  {
    num: '05',
    title: 'Constituer votre boîte à outils',
    href: '/fr/toolkit/',
    desc: 'Modèles, check-lists, exemples concrets et documentation d’API.',
  },
  {
    num: '06',
    title: 'Automatisation et techniques spécialisées',
    href: '/fr/tutorials/',
    desc: 'Jinja, Python, sed, Sphinx/ReST, XSL-FO et Raspberry Pi : techniques spécialisées ou historiques.',
  },
] : [
  {
    num: '01',
    title: 'Understand documentation',
    href: '/en/learn/',
    desc: 'The value of documentation, documentation maturity, technical writing vs technical communication, and information types.',
  },
  {
    num: '02',
    title: 'Build a documentation process',
    href: '/en/process/',
    desc: 'Define, gather, test, create, review, translate, and publish — in the order the work actually happens.',
  },
  {
    num: '03',
    title: 'Adopt docs-as-code',
    href: '/en/docs-as-code/',
    desc: 'Treating documentation like code: aligning release cadence, version control, automated testing, and CI/CD pipelines.',
  },
  {
    num: '04',
    title: 'Choose an authoring model',
    href: '/en/tools-and-formats/',
    desc: 'Markdown, structured authoring, DITA, content reuse, and source vs target formats.',
  },
  {
    num: '05',
    title: 'Build your toolkit',
    href: '/en/toolkit/',
    desc: 'Templates, checklists, worked examples, and API documentation.',
  },
  {
    num: '06',
    title: 'Automation & legacy techniques',
    href: '/en/tutorials/',
    desc: 'Jinja, Python, sed, Sphinx/ReST, XSL-FO, and Raspberry Pi: specialist or historical techniques.',
  },
];
---

<section class="start-here-panel not-content" aria-labelledby="start-here-heading">
  <div class="start-here-header">
    <span class="start-here-kicker">{isFr ? 'Commencez ici' : 'Start Here'}</span>
    <h2 id="start-here-heading" class="start-here-title">
      {isFr ? 'Six parcours à travers la documentation technique' : 'Six paths through technical documentation'}
    </h2>
    <p class="start-here-desc">
      {isFr
        ? 'Si vous découvrez ce site ou repensez votre architecture documentaire, suivez ces six sections dans l’ordre :'
        : 'New to the site or re-evaluating your documentation architecture? Follow the six sections in order:'}
    </p>
  </div>

  <div class="start-here-sequence" role="list">
    {steps.map((step) => (
      <div class="start-here-item" role="listitem">
        <a href={step.href} class="start-here-link">
          <span class="start-here-num" aria-hidden="true">{step.num}</span>
          <div class="start-here-content">
            <span class="start-here-step-title">{step.title}</span>
            <span class="start-here-step-desc">{step.desc}</span>
          </div>
          <svg class="start-here-arrow" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.92 11.62a1.001 1.001 0 0 0-.21-.33l-5-5a1.003 1.003 0 1 0-1.42 1.42l3.3 3.29H7a1 1 0 0 0 0 2h7.59l-3.3 3.29a1.002 1.002 0 0 0 .325 1.639 1 1 0 0 0 1.095-.219l5-5a1 1 0 0 0 .21-.33 1 1 0 0 0 0-.76Z"/>
          </svg>
        </a>
      </div>
    ))}
  </div>
</section>

<style>
  .start-here-panel {
    margin: 0 0 3.5rem 0;
    padding: 1.5rem 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .start-here-header {
    margin-bottom: 1.25rem;
  }

  .start-here-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }

  .start-here-title {
    font-size: clamp(1.25rem, calc(1rem + 1vw), 1.6rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.25;
    margin: 0 0 0.5rem 0;
  }

  .start-here-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .start-here-sequence {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .start-here-item {
    margin: 0;
  }

  .start-here-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 0.85rem 1.15rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
    position: relative;
  }

  .start-here-link:hover {
    border-color: var(--color-accent);
  }

  .start-here-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .start-here-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
    align-self: center;
  }

  .start-here-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .start-here-step-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.35;
  }

  .start-here-link:hover .start-here-step-title {
    color: var(--color-accent);
  }

  .start-here-step-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .start-here-arrow {
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .start-here-link:hover .start-here-arrow {
    color: var(--color-accent);
    transform: translateX(3px);
  }

  @media (max-width: 40rem) {
    .start-here-panel {
      padding: 1.25rem 1rem;
    }
    .start-here-link {
      grid-template-columns: auto 1fr auto;
      gap: 0.75rem;
      padding: 0.75rem;
    }
    .start-here-num {
      align-self: flex-start;
      margin-top: 0.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .start-here-link,
    .start-here-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
