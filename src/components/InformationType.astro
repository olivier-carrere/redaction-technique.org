---
import type { ContentType } from '../lib/content-types.ts';

interface Props {
  type: ContentType;
}

const { type } = Astro.props;
const pathname = Astro.url.pathname;
const isFr = pathname.startsWith('/fr');

const typeData = {
  concept: {
    nameEn: 'Concept',
    nameFr: 'Concept',
    questionEn: 'What is it?',
    questionFr: "Qu'est-ce que c'est ?",
    descEn: 'Understanding, background, definitions, and mental models',
    descFr: 'Compréhension, contexte, définitions et modèles conceptuels',
  },
  task: {
    nameEn: 'Task',
    nameFr: 'Tâche',
    questionEn: 'How do I do it?',
    questionFr: 'Comment faire ?',
    descEn: 'Step-by-step procedural workflow toward a verifiable outcome',
    descFr: 'Procédure étape par étape orientée vers un résultat vérifiable',
  },
  reference: {
    nameEn: 'Reference',
    nameFr: 'Référence',
    questionEn: 'What are the details?',
    questionFr: 'Quels sont les détails ?',
    descEn: 'Structured lookup data, exact syntax, parameters, and constraints',
    descFr: 'Données de référence, syntaxe exacte, paramètres et contraintes',
  },
};

const current = typeData[type] || typeData.concept;
const href = isFr ? '/fr/toolkit/information-types/' : '/en/toolkit/information-types/';
const prefix = isFr ? "Type d'information :" : 'Information type:';
const typeName = isFr ? current.nameFr : current.nameEn;
const question = isFr ? current.questionFr : current.questionEn;
const description = isFr ? current.descFr : current.descEn;
---

<aside class="information-type-callout not-content" aria-label={prefix}>
  <div class="it-header">
    <span class="it-prefix">{prefix}</span>
    <a href={href} class={`it-badge it-badge-${type}`} title={isFr ? "En savoir plus sur la typologie de l'information" : "Learn more about information typing"}>
      <span class="it-badge-name">{typeName}</span>
      <span class="it-badge-dot" aria-hidden="true">•</span>
      <span class="it-badge-question">"{question}"</span>
    </a>
  </div>
  <p class="it-desc">{description}</p>
</aside>

<style>
  .information-type-callout {
    margin: 1.25rem 0 1.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
    font-size: var(--sl-text-sm);
  }

  .it-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .it-prefix {
    font-weight: 600;
    color: var(--color-text);
  }

  .it-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-decoration: none;
    line-height: 1.4;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .it-badge:hover {
    text-decoration: underline;
  }

  .it-badge-dot {
    opacity: 0.6;
  }

  .it-badge-question {
    font-weight: 400;
    font-style: italic;
  }

  /* Concept palette */
  .it-badge-concept {
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
  }

  /* Task palette (Success) */
  .it-badge-task {
    background: rgba(71, 116, 92, 0.12);
    border: 1px solid var(--color-success);
    color: var(--color-success);
  }

  /* Reference palette (Warning) */
  .it-badge-reference {
    background: rgba(163, 106, 50, 0.12);
    border: 1px solid var(--color-warning);
    color: var(--color-warning);
  }

  .it-desc {
    margin: 0.35rem 0 0 0 !important;
    color: var(--color-text-muted);
    font-size: var(--sl-text-xs);
    line-height: 1.4;
  }
</style>
