---
// Recruiter call to action on the expertise page: availability (shared
// AVAILABILITY data) and the existing profile and LinkedIn links. Styled
// like the site's other accent-bordered orientation blocks.
import Availability from '../Availability.astro';

interface Props {
  lang?: 'en' | 'fr';
}

const { lang = 'en' } = Astro.props;
const t = lang === 'fr'
  ? {
      title: 'Vous recherchez un rédacteur technique senior ?',
      profile: 'profil professionnel',
      profileNote: ' (en anglais)',
      before: 'Consultez mon ',
      middle: ' ou ',
      linkedin: 'contactez-moi sur LinkedIn',
    }
  : {
      title: 'Looking for a Senior Technical Writer?',
      profile: 'professional profile',
      profileNote: '',
      before: 'See my ',
      middle: ' or ',
      linkedin: 'contact me on LinkedIn',
    };
---

<aside class="hire-cta not-content" aria-label={t.title}>
  <p class="hire-cta-title">{t.title}</p>
  <Availability lang={lang} />
  <p class="hire-cta-links">
    {t.before}<a href="https://redaction-technique.org/">{t.profile}</a><span aria-hidden="true"> ↗</span>{t.profileNote}{t.middle}<a href="https://www.linkedin.com/in/carrereolivier/">{t.linkedin}</a><span aria-hidden="true"> ↗</span>.
  </p>
</aside>

<style>
  .hire-cta {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    max-width: var(--content-width);
    margin-block: 1.5rem 0;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-inline-start: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
  }

  .hire-cta p {
    margin: 0;
  }

  .hire-cta-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text);
  }

  .hire-cta-links {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .hire-cta-links a {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hire-cta-links a:hover {
    color: var(--color-text);
  }

  .hire-cta-links a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
