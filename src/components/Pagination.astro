---
import type { SidebarEntry, SidebarLink, SidebarGroup } from '@astrojs/starlight/utils/routing/types';

const route = Astro.locals.starlightRoute;
const { dir, lang, sidebar, entry } = route;
const isRtl = dir === 'rtl';
const isFr = lang === 'fr';

function flattenSidebar(entries: SidebarEntry[]): SidebarLink[] {
  return entries.flatMap((item) =>
    item.type === 'group' ? flattenSidebar(item.entries) : item
  );
}

function findGroupContainingCurrent(entries: SidebarEntry[]): SidebarGroup | undefined {
  for (const item of entries) {
    if (item.type === 'group') {
      const flat = flattenSidebar(item.entries);
      if (flat.some((link) => link.isCurrent)) {
        return item;
      }
    }
  }
  return undefined;
}

const currentGroup = findGroupContainingCurrent(sidebar);

let prev: SidebarLink | undefined;
let next: SidebarLink | undefined;

if (currentGroup) {
  // Respect section boundaries: only navigate within the current group
  const groupLinks = flattenSidebar(currentGroup.entries).filter((link) => {
    return link.type === 'link' && !link.href.startsWith('http://') && !link.href.startsWith('https://');
  });

  const currentIndex = groupLinks.findIndex((link) => link.isCurrent);
  if (currentIndex > -1) {
    prev = currentIndex > 0 ? groupLinks[currentIndex - 1] : undefined;
    next = currentIndex < groupLinks.length - 1 ? groupLinks[currentIndex + 1] : undefined;
  }
} else {
  // Standalone page fallback (safeguarded against external links or blog root)
  const defaultPagination = route.pagination;
  if (
    defaultPagination?.prev &&
    !defaultPagination.prev.href.startsWith('http://') &&
    !defaultPagination.prev.href.startsWith('https://')
  ) {
    prev = defaultPagination.prev;
  }
  if (
    defaultPagination?.next &&
    !defaultPagination.next.href.startsWith('http://') &&
    !defaultPagination.next.href.startsWith('https://')
  ) {
    next = defaultPagination.next;
  }
}

// Frontmatter overrides
const frontmatterPrev = entry?.data?.prev;
const frontmatterNext = entry?.data?.next;

if (frontmatterPrev === false) prev = undefined;
if (frontmatterNext === false) next = undefined;

if (typeof frontmatterPrev === 'string' && prev) {
  prev = { ...prev, label: frontmatterPrev };
} else if (typeof frontmatterPrev === 'object' && frontmatterPrev !== null) {
  if (prev) {
    prev = { ...prev, label: frontmatterPrev.label ?? prev.label, href: frontmatterPrev.link ?? prev.href };
  } else if (frontmatterPrev.link && frontmatterPrev.label) {
    prev = { type: 'link', href: frontmatterPrev.link, label: frontmatterPrev.label, isCurrent: false, badge: undefined, attrs: {} };
  }
}

if (typeof frontmatterNext === 'string' && next) {
  next = { ...next, label: frontmatterNext };
} else if (typeof frontmatterNext === 'object' && frontmatterNext !== null) {
  if (next) {
    next = { ...next, label: frontmatterNext.label ?? next.label, href: frontmatterNext.link ?? next.href };
  } else if (frontmatterNext.link && frontmatterNext.label) {
    next = { type: 'link', href: frontmatterNext.link, label: frontmatterNext.label, isCurrent: false, badge: undefined, attrs: {} };
  }
}
---

{ (prev || next) && (
  <nav class="pagination-nav print:hidden" aria-label={isFr ? 'Navigation dans la section' : 'Section navigation'} dir={dir}>
    <div class="pagination-grid">
      {prev ? (
        <a href={prev.href} rel="prev" class="pagination-card pagination-prev">
          <div class="pagination-meta">
            <span class="pagination-arrow" aria-hidden="true">{isRtl ? '→' : '←'}</span>
            <span class="pagination-direction">{isFr ? 'Précédent' : 'Previous'}</span>
          </div>
          <span class="pagination-title">{prev.label}</span>
        </a>
      ) : (
        <div class="pagination-placeholder" aria-hidden="true"></div>
      )}

      {next ? (
        <a href={next.href} rel="next" class="pagination-card pagination-next">
          <div class="pagination-meta">
            <span class="pagination-direction">{isFr ? 'Suivant' : 'Next'}</span>
            <span class="pagination-arrow" aria-hidden="true">{isRtl ? '←' : '→'}</span>
          </div>
          <span class="pagination-title">{next.label}</span>
        </a>
      ) : (
        <div class="pagination-placeholder" aria-hidden="true"></div>
      )}
    </div>
  </nav>
)}

<style>
  .pagination-nav {
    margin-top: 1.5rem;
  }

  .pagination-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .pagination-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.1rem 1.25rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .pagination-next {
    text-align: right;
  }

  .pagination-next .pagination-meta {
    justify-content: flex-end;
  }

  .pagination-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pagination-direction {
    font-size: var(--sl-text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--sl-color-gray-3);
  }

  .pagination-arrow {
    font-size: 1rem;
    color: var(--sl-color-gray-3);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .pagination-title {
    display: block;
    margin-top: 0.35rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-white);
    line-height: 1.35;
    transition: color 0.15s ease;
  }

  .pagination-card:hover {
    background: var(--sl-color-gray-5);
    border-color: var(--sl-color-gray-3);
  }

  .pagination-card:hover .pagination-title {
    color: var(--sl-color-accent-high);
  }

  .pagination-card:hover .pagination-arrow {
    color: var(--sl-color-accent-high);
  }

  .pagination-prev:hover .pagination-arrow {
    transform: translateX(-3px);
  }

  .pagination-next:hover .pagination-arrow {
    transform: translateX(3px);
  }

  .pagination-card:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .pagination-placeholder {
    display: block;
  }

  @media (max-width: 48rem) {
    .pagination-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .pagination-placeholder {
      display: none;
    }

    .pagination-next {
      text-align: left;
    }

    .pagination-next .pagination-meta {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pagination-card,
    .pagination-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
