---
/**
 * DocumentationExplorer.astro
 *
 * Lightweight, interactive, client-side Documentation Explorer built on top of the
 * public static documentation API.
 *
 * Provides: Discover → Filter → Inspect → Retrieve
 *
 * - Instant in-browser search across title, description, headings, keywords, and tags
 * - Canonical taxonomy filters (contentType, pageType, language)
 * - HTML and Markdown dual-retrieval model with clear Human vs LLM affordances
 * - Accessible "Copy Markdown URL" action with visible & screen-reader feedback
 * - "Copy API query" action reflecting current filter state
 * - Shareable URL state (?q=...&contentType=...&pageType=...&lang=...) with popstate support
 * - Touch-friendly responsive targets (min 44px on mobile)
 * - Zero external dependencies, pure vanilla JS and native CSS
 */
import { CONTENT_TYPES, PAGE_TYPES } from '../lib/content-types';

interface Props {
  lang?: 'en' | 'fr';
}

const { lang = 'en' } = Astro.props;
const isFr = lang === 'fr';

const t = {
  en: {
    title: 'Documentation Explorer',
    searchLabel: 'Search documentation topics',
    searchPlaceholder: 'Search by keyword, concept, task, tool (e.g. DITA, Git, regex)…',
    clearSearch: 'Clear search',
    filtersHeading: 'Filters',
    langLabel: 'Language',
    allLangs: 'All languages',
    enLang: 'English',
    frLang: 'Français',
    contentTypeLabel: 'Information type',
    allContentTypes: 'All information types',
    conceptType: 'Concept',
    taskType: 'Task',
    referenceType: 'Reference',
    pageTypeLabel: 'Structural role',
    allPageTypes: 'All page roles',
    topicPage: 'Topic',
    indexPage: 'Index',
    landingPage: 'Landing page',
    overviewPage: 'Overview',
    utilityPage: 'Utility',
    countAll: '{total} documents',
    countFiltered: '{count} of {total} documents',
    countSingle: '1 document',
    countZero: '0 documents',
    resetFilters: 'Reset filters',
    copyApiQuery: 'Copy API query',
    copiedApiQuery: '✓ Query URL copied',
    readDoc: 'Read documentation →',
    viewMarkdown: 'Markdown ↗',
    copyMarkdownUrl: 'Copy Markdown URL',
    copiedMarkdownUrl: '✓ Markdown URL copied',
    noResultsTitle: 'No documentation matches your query',
    noResultsSuggestion: 'No articles match the current search term and filters. Try relaxing your filters or clearing search terms to browse all documents.',
    loading: 'Loading documentation index…',
  },
  fr: {
    title: 'Explorateur de documentation',
    searchLabel: 'Rechercher dans les rubriques documentaires',
    searchPlaceholder: 'Rechercher par mot-clé, concept, tâche, outil (ex. DITA, Git, regex)…',
    clearSearch: 'Effacer la recherche',
    filtersHeading: 'Filtres',
    langLabel: 'Langue',
    allLangs: 'Toutes les langues',
    enLang: 'English',
    frLang: 'Français',
    contentTypeLabel: "Type d'information",
    allContentTypes: "Tous les types d'information",
    conceptType: 'Concept',
    taskType: 'Tâche',
    referenceType: 'Référence',
    pageTypeLabel: 'Rôle structurel',
    allPageTypes: 'Tous les rôles',
    topicPage: 'Sujet (Topic)',
    indexPage: 'Index',
    landingPage: 'Page de renvoi (Landing)',
    overviewPage: "Vue d'ensemble (Overview)",
    utilityPage: 'Utilitaire (Utility)',
    countAll: '{total} documents',
    countFiltered: '{count} sur {total} documents',
    countSingle: '1 document',
    countZero: '0 document',
    resetFilters: 'Réinitialiser les filtres',
    copyApiQuery: "Copier la requête d'API",
    copiedApiQuery: '✓ Requête URL copiée',
    readDoc: 'Consulter la documentation →',
    viewMarkdown: 'Markdown ↗',
    copyMarkdownUrl: "Copier l'URL Markdown",
    copiedMarkdownUrl: '✓ URL Markdown copiée',
    noResultsTitle: 'Aucun document correspondant',
    noResultsSuggestion: 'Aucune rubrique ne correspond à vos termes de recherche et filtres actuels. Essayez d’élargir votre recherche ou de réinitialiser les filtres pour parcourir l’ensemble du corpus.',
    loading: 'Chargement de l’index documentaire…',
  },
}[isFr ? 'fr' : 'en'];
---

<div
  class="doc-explorer not-content"
  id="doc-explorer"
  data-lang={lang}
  data-site-url="https://docs.redaction-technique.org"
>
  <!-- Search and Controls Panel -->
  <div class="doc-explorer-panel">
    <!-- Search Bar (Visually Dominant) -->
    <div class="doc-explorer-search-row" role="search" aria-label={t.title}>
      <label for="doc-explorer-search" class="sr-only">{t.searchLabel}</label>
      <div class="doc-explorer-search-wrapper">
        <svg class="doc-explorer-search-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="doc-explorer-search"
          class="doc-explorer-input"
          placeholder={t.searchPlaceholder}
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          id="doc-explorer-clear"
          class="doc-explorer-clear-btn"
          aria-label={t.clearSearch}
          hidden
        >
          ✕
        </button>
      </div>
    </div>

    <!-- Filters Row (Secondary Hierarchy) -->
    <div class="doc-explorer-filters-row">
      <!-- Language Filter -->
      <div class="doc-explorer-filter-group">
        <label for="doc-explorer-filter-lang" class="doc-explorer-label">{t.langLabel}</label>
        <select id="doc-explorer-filter-lang" class="doc-explorer-select">
          <option value="en" selected={lang === 'en'}>{t.enLang}</option>
          <option value="fr" selected={lang === 'fr'}>{t.frLang}</option>
          <option value="all">{t.allLangs}</option>
        </select>
      </div>

      <!-- Information Type Filter -->
      <div class="doc-explorer-filter-group">
        <label for="doc-explorer-filter-content-type" class="doc-explorer-label">{t.contentTypeLabel}</label>
        <select id="doc-explorer-filter-content-type" class="doc-explorer-select">
          <option value="all">{t.allContentTypes}</option>
          {CONTENT_TYPES.map((ct) => (
            <option value={ct}>
              {ct === 'concept' ? t.conceptType : ct === 'task' ? t.taskType : t.referenceType}
            </option>
          ))}
        </select>
      </div>

      <!-- Page Role Filter -->
      <div class="doc-explorer-filter-group">
        <label for="doc-explorer-filter-page-type" class="doc-explorer-label">{t.pageTypeLabel}</label>
        <select id="doc-explorer-filter-page-type" class="doc-explorer-select">
          <option value="all">{t.allPageTypes}</option>
          {PAGE_TYPES.map((pt) => (
            <option value={pt}>
              {pt === 'topic' ? t.topicPage : pt === 'index' ? t.indexPage : pt === 'landing' ? t.landingPage : pt === 'overview' ? t.overviewPage : t.utilityPage}
            </option>
          ))}
        </select>
      </div>
    </div>

    <!-- Status Bar / Actions -->
    <div class="doc-explorer-status-bar">
      <span id="doc-explorer-count" class="doc-explorer-count" aria-live="polite">
        {t.loading}
      </span>
      <div class="doc-explorer-actions">
        <button
          type="button"
          id="doc-explorer-reset-btn"
          class="doc-explorer-btn doc-explorer-btn-ghost"
          hidden
        >
          {t.resetFilters}
        </button>
        <button
          type="button"
          id="doc-explorer-copy-query-btn"
          class="doc-explorer-btn doc-explorer-btn-outline"
          title="Copy the public API query URL corresponding to current filters"
        >
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="btn-text">{t.copyApiQuery}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Live region for global clipboard feedback -->
  <div id="doc-explorer-feedback" class="sr-only" aria-live="assertive"></div>

  <!-- Results List -->
  <div id="doc-explorer-results" class="doc-explorer-results" aria-live="polite"></div>

  <!-- Empty State -->
  <div id="doc-explorer-empty" class="doc-explorer-empty" hidden>
    <div class="doc-explorer-empty-icon" aria-hidden="true">🔍</div>
    <h3 class="doc-explorer-empty-title">{t.noResultsTitle}</h3>
    <p class="doc-explorer-empty-desc">{t.noResultsSuggestion}</p>
    <button type="button" id="doc-explorer-empty-reset" class="doc-explorer-btn doc-explorer-btn-primary">
      {t.resetFilters}
    </button>
  </div>
</div>

<script>
  /**
   * Documentation Explorer Client Controller
   */
  interface DocumentResource {
    title: string;
    description?: string;
    url: string;
    markdown: string;
    locale: 'en' | 'fr';
    pageType: string;
    contentType: string | null;
    wordCount?: number;
    headings?: Array<{ level: number; text: string; slug?: string }>;
    keywords?: string[];
    tags?: string[];
  }

  interface CatalogIndex {
    count: number;
    documents: DocumentResource[];
  }

  const catalogCache = new Map<string, DocumentResource[]>();

  function initDocExplorer() {
    const root = document.getElementById('doc-explorer');
    if (!root) return;

    const defaultLang = root.dataset.lang === 'fr' ? 'fr' : 'en';
    const siteUrl = root.dataset.siteUrl || window.location.origin;

    // UI elements
    const searchInput = document.getElementById('doc-explorer-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('doc-explorer-clear') as HTMLButtonElement | null;
    const langSelect = document.getElementById('doc-explorer-filter-lang') as HTMLSelectElement | null;
    const ctSelect = document.getElementById('doc-explorer-filter-content-type') as HTMLSelectElement | null;
    const ptSelect = document.getElementById('doc-explorer-filter-page-type') as HTMLSelectElement | null;
    const countEl = document.getElementById('doc-explorer-count');
    const resetBtn = document.getElementById('doc-explorer-reset-btn') as HTMLButtonElement | null;
    const copyQueryBtn = document.getElementById('doc-explorer-copy-query-btn') as HTMLButtonElement | null;
    const resultsContainer = document.getElementById('doc-explorer-results');
    const emptyState = document.getElementById('doc-explorer-empty');
    const emptyResetBtn = document.getElementById('doc-explorer-empty-reset');
    const feedbackEl = document.getElementById('doc-explorer-feedback');

    if (!searchInput || !langSelect || !ctSelect || !ptSelect || !resultsContainer || !emptyState) {
      return;
    }

    const isFrUi = defaultLang === 'fr';
    const strings = {
      readDoc: isFrUi ? 'Consulter la documentation →' : 'Read documentation →',
      viewMarkdown: 'Markdown ↗',
      copyMarkdownUrl: isFrUi ? "Copier l'URL Markdown" : 'Copy Markdown URL',
      copiedMarkdownUrl: isFrUi ? '✓ URL Markdown copiée' : '✓ Markdown URL copied',
      copyApiQuery: isFrUi ? "Copier la requête d'API" : 'Copy API query',
      copiedApiQuery: isFrUi ? '✓ Requête URL copiée' : '✓ Query URL copied',
      countAll: isFrUi ? '{total} documents' : '{total} documents',
      countFiltered: isFrUi ? '{count} sur {total} documents' : '{count} of {total} documents',
      countSingle: isFrUi ? '1 document' : '1 document',
      countZero: isFrUi ? '0 document' : '0 documents',
    };

    // Parse URL Search Parameters for shareable initial state
    function loadStateFromUrl() {
      const params = new URLSearchParams(window.location.search);
      if (params.has('q')) searchInput!.value = params.get('q') || '';
      if (params.has('lang')) {
        const qLang = params.get('lang');
        if (['en', 'fr', 'all'].includes(qLang || '')) langSelect!.value = qLang!;
      }
      if (params.has('contentType')) {
        const qCt = params.get('contentType');
        if (['concept', 'task', 'reference', 'all'].includes(qCt || '')) ctSelect!.value = qCt!;
      }
      if (params.has('pageType')) {
        const qPt = params.get('pageType');
        if (['topic', 'index', 'landing', 'overview', 'utility', 'all'].includes(qPt || '')) ptSelect!.value = qPt!;
      }
    }

    loadStateFromUrl();

    // Toggle clear search button visibility
    function updateClearBtn() {
      if (clearBtn) clearBtn.hidden = !searchInput!.value;
    }

    // Fetch documents for the required catalog
    async function fetchCatalog(langVal: string): Promise<DocumentResource[]> {
      const endpoint =
        langVal === 'en'
          ? '/en/index.json'
          : langVal === 'fr'
            ? '/fr/index.json'
            : '/index.json';

      if (catalogCache.has(endpoint)) {
        return catalogCache.get(endpoint)!;
      }

      try {
        const res = await fetch(endpoint);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data: CatalogIndex = await res.json();
        catalogCache.set(endpoint, data.documents || []);
        return data.documents || [];
      } catch (err) {
        console.error(`[DocExplorer] Failed to load ${endpoint}:`, err);
        return [];
      }
    }

    // Diacritic & Case normalization for robust text search
    function normalizeStr(str: string): string {
      return (str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .trim();
    }

    // Update query string in URL without full page reload
    function syncUrlState() {
      const params = new URLSearchParams();
      const qVal = searchInput!.value.trim();
      const langVal = langSelect!.value;
      const ctVal = ctSelect!.value;
      const ptVal = ptSelect!.value;

      if (qVal) params.set('q', qVal);
      if (langVal !== defaultLang) params.set('lang', langVal);
      if (ctVal !== 'all') params.set('contentType', ctVal);
      if (ptVal !== 'all') params.set('pageType', ptVal);

      const qs = params.toString();
      const newUrl = qs
        ? `${window.location.pathname}?${qs}${window.location.hash || ''}`
        : `${window.location.pathname}${window.location.hash || ''}`;

      window.history.replaceState(null, '', newUrl);
    }

    // Compute the equivalent public API query URL
    function getEquivalentApiQueryUrl(): string {
      const langVal = langSelect!.value;
      const ctVal = ctSelect!.value;
      const ptVal = ptSelect!.value;

      let baseEndpoint = `${siteUrl}/index.json`;
      const queryParams = new URLSearchParams();

      if (langVal === 'en') {
        baseEndpoint = `${siteUrl}/en/index.json`;
      } else if (langVal === 'fr') {
        baseEndpoint = `${siteUrl}/fr/index.json`;
      }

      if (ctVal !== 'all') queryParams.set('contentType', ctVal);
      if (ptVal !== 'all') queryParams.set('pageType', ptVal);
      queryParams.set('fields', 'title,url,markdown,contentType');

      const qs = queryParams.toString();
      return qs ? `${baseEndpoint}?${qs}` : baseEndpoint;
    }

    // Announce to assistive tech
    function announce(msg: string) {
      if (feedbackEl) {
        feedbackEl.textContent = msg;
      }
    }

    // Main render function
    async function applyFilters() {
      updateClearBtn();
      syncUrlState();

      const langVal = langSelect!.value;
      const ctVal = ctSelect!.value;
      const ptVal = ptSelect!.value;
      const queryTokens = normalizeStr(searchInput!.value)
        .split(/\s+/)
        .filter(Boolean);

      const isModified =
        searchInput!.value.trim() !== '' ||
        langVal !== defaultLang ||
        ctVal !== 'all' ||
        ptVal !== 'all';

      if (resetBtn) resetBtn.hidden = !isModified;

      const docs = await fetchCatalog(langVal);

      const filtered = docs.filter((doc) => {
        // ContentType filter
        if (ctVal !== 'all' && doc.contentType !== ctVal) return false;

        // PageType filter
        if (ptVal !== 'all' && doc.pageType !== ptVal) return false;

        // Text Search
        if (queryTokens.length > 0) {
          const docTitle = normalizeStr(doc.title);
          const docDesc = normalizeStr(doc.description || '');
          const docHeadings = (doc.headings || []).map((h) => normalizeStr(h.text)).join(' ');
          const docTags = (doc.tags || []).map(normalizeStr).join(' ');
          const docKeywords = (doc.keywords || []).map(normalizeStr).join(' ');
          const docSlug = normalizeStr(doc.url);

          const fullSearchable = `${docTitle} ${docDesc} ${docHeadings} ${docTags} ${docKeywords} ${docSlug}`;

          const allTokensMatch = queryTokens.every((token) => fullSearchable.includes(token));
          if (!allTokensMatch) return false;
        }

        return true;
      });

      // Concise, intuitive result count wording
      if (countEl) {
        if (filtered.length === docs.length) {
          countEl.textContent = strings.countAll.replace('{total}', String(docs.length));
        } else if (filtered.length === 0) {
          countEl.textContent = strings.countZero;
        } else if (filtered.length === 1 && docs.length > 1) {
          countEl.textContent = strings.countFiltered
            .replace('{count}', '1')
            .replace('{total}', String(docs.length));
        } else {
          countEl.textContent = strings.countFiltered
            .replace('{count}', String(filtered.length))
            .replace('{total}', String(docs.length));
        }
      }

      // Empty state
      if (filtered.length === 0) {
        resultsContainer!.innerHTML = '';
        emptyState!.hidden = false;
        return;
      }

      emptyState!.hidden = true;

      // Render cards: Title first -> Badges -> Description -> Action buttons
      resultsContainer!.innerHTML = filtered
        .map((doc) => {
          const ctLabel = doc.contentType
            ? doc.contentType === 'task'
              ? isFrUi ? 'Tâche' : 'Task'
              : doc.contentType === 'concept'
                ? 'Concept'
                : isFrUi ? 'Référence' : 'Reference'
            : null;

          const ptLabel =
            doc.pageType === 'topic'
              ? isFrUi ? 'Sujet' : 'Topic'
              : doc.pageType === 'landing'
                ? isFrUi ? 'Renvoi' : 'Landing'
                : doc.pageType === 'overview'
                  ? isFrUi ? 'Aperçu' : 'Overview'
                  : doc.pageType === 'index'
                    ? 'Index'
                    : 'Utility';

          const ctBadge = ctLabel
            ? `<span class="doc-card-badge doc-card-badge-${doc.contentType}">${ctLabel}</span>`
            : '';
          const ptBadge = `<span class="doc-card-badge doc-card-badge-role">${ptLabel}</span>`;
          const langBadge = `<span class="doc-card-badge doc-card-badge-lang">${doc.locale.toUpperCase()}</span>`;

          const descHtml = doc.description
            ? `<p class="doc-card-desc">${escapeHtml(doc.description)}</p>`
            : '';

          return `
            <article class="doc-card">
              <div class="doc-card-header">
                <h3 class="doc-card-title">
                  <a href="${escapeHtml(doc.url)}" class="doc-card-title-link">${escapeHtml(doc.title)}</a>
                </h3>
                <div class="doc-card-badges">
                  ${ctBadge}
                  ${ptBadge}
                  ${langBadge}
                </div>
              </div>
              ${descHtml}
              <div class="doc-card-actions">
                <a href="${escapeHtml(doc.url)}" class="doc-card-btn doc-card-btn-primary">
                  ${strings.readDoc}
                </a>
                <a href="${escapeHtml(doc.markdown)}" class="doc-card-btn doc-card-btn-markdown" title="${strings.viewMarkdown}">
                  <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                  </svg>
                  <span>${strings.viewMarkdown}</span>
                </a>
                <button
                  type="button"
                  class="doc-card-btn doc-card-btn-copy js-copy-md"
                  data-markdown-url="${escapeHtml(doc.markdown)}"
                  aria-label="${strings.copyMarkdownUrl}: ${escapeHtml(doc.title)}"
                >
                  <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span class="btn-text">${strings.copyMarkdownUrl}</span>
                </button>
              </div>
            </article>
          `;
        })
        .join('');
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Event listeners
    let debounceTimer: ReturnType<typeof setTimeout> | null = null;
    searchInput.addEventListener('input', () => {
      if (debounceTimer) clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyFilters, 120);
    });

    // Enter key triggers immediate search update
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        if (debounceTimer) clearTimeout(debounceTimer);
        applyFilters();
      }
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchInput.focus();
        applyFilters();
      });
    }

    langSelect.addEventListener('change', applyFilters);
    ctSelect.addEventListener('change', applyFilters);
    ptSelect.addEventListener('change', applyFilters);

    function resetAllFilters() {
      searchInput!.value = '';
      langSelect!.value = defaultLang;
      ctSelect!.value = 'all';
      ptSelect!.value = 'all';
      searchInput!.focus();
      applyFilters();
    }

    if (resetBtn) resetBtn.addEventListener('click', resetAllFilters);
    if (emptyResetBtn) emptyResetBtn.addEventListener('click', resetAllFilters);

    // Browser Back / Forward popstate handler
    window.addEventListener('popstate', () => {
      loadStateFromUrl();
      applyFilters();
    });

    // Copy API query URL button
    if (copyQueryBtn) {
      copyQueryBtn.addEventListener('click', async () => {
        const queryUrl = getEquivalentApiQueryUrl();
        try {
          await navigator.clipboard.writeText(queryUrl);
          const textSpan = copyQueryBtn.querySelector('.btn-text');
          if (textSpan) textSpan.textContent = strings.copiedApiQuery;
          copyQueryBtn.classList.add('doc-explorer-btn-copied');
          announce(strings.copiedApiQuery);
          setTimeout(() => {
            if (textSpan) textSpan.textContent = strings.copyApiQuery;
            copyQueryBtn.classList.remove('doc-explorer-btn-copied');
          }, 2000);
        } catch (err) {
          console.error('[DocExplorer] Clipboard access denied:', err);
        }
      });
    }

    // Delegated click event for card "Copy Markdown URL" buttons
    resultsContainer.addEventListener('click', async (e) => {
      const target = (e.target as HTMLElement).closest('.js-copy-md') as HTMLButtonElement | null;
      if (!target) return;

      const mdUrl = target.dataset.markdownUrl;
      if (!mdUrl) return;

      try {
        await navigator.clipboard.writeText(mdUrl);
        const textSpan = target.querySelector('.btn-text');
        if (textSpan) textSpan.textContent = strings.copiedMarkdownUrl;
        target.classList.add('doc-card-btn-copied');
        announce(strings.copiedMarkdownUrl);

        setTimeout(() => {
          if (textSpan) textSpan.textContent = strings.copyMarkdownUrl;
          target.classList.remove('doc-card-btn-copied');
        }, 2000);
      } catch (err) {
        console.error('[DocExplorer] Clipboard write failed:', err);
      }
    });

    // Initial load
    applyFilters();
  }

  // Initialize on page load and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDocExplorer);
  } else {
    initDocExplorer();
  }
  document.addEventListener('astro:page-load', initDocExplorer);
</script>

<style>
  .doc-explorer {
    margin: 2rem 0 3rem;
    font-family: var(--sl-font);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Control Panel */
  .doc-explorer-panel {
