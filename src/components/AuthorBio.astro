---
// Discreet author box at the end of documentation topics (rendered by
// Pagination.astro). Links the article to the expertise area it evidences,
// so readers can go article → expertise → related articles.
import { expertiseAnchor, getExpertiseAreaForEntry } from '../lib/expertise';

const route = (Astro.locals as Record<string, any>)?.starlightRoute;
const lang = route?.lang === 'fr' ? 'fr' : 'en';
const isFr = lang === 'fr';
const area = getExpertiseAreaForEntry(route?.entry?.id);
const headingId = 'author-box-heading';
---

<aside class="author-box not-content" aria-labelledby={headingId}>
  <h2 id={headingId} class="author-box-title">{isFr ? 'À propos de l’auteur' : 'About the author'}</h2>
  <p class="author-box-text">
    {isFr
      ? 'Olivier Carrère est rédacteur technique senior, spécialisé dans la documentation développeur, le docs-as-code, la rédaction structurée et l’architecture documentaire.'
      : 'Olivier Carrère is a senior technical writer specializing in developer documentation, docs-as-code, structured authoring, and documentation architecture.'}
  </p>
  <ul class="author-box-links">
    {area && (
      <li>
        <a href={`/${lang}/expertise/#${expertiseAnchor(area, lang)}`}>
          {isFr ? 'Expertise associée : ' : 'Related expertise: '}{area.label[lang]}
        </a>
      </li>
    )}
    <li><a href={`/${lang}/about-this-blog/`}>{isFr ? 'À propos et contact' : 'About and contact'}</a></li>
    <li>
      <a href="https://redaction-technique.org/about" hreflang="en">
        {isFr ? 'Profil professionnel (en anglais)' : 'Professional profile'}&nbsp;↗
      </a>
    </li>
  </ul>
</aside>

<style>
  .author-box {
    margin-top: 2.25rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .author-box-title {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .author-box-text {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .author-box-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
  }

  .author-box-links li {
    margin: 0;
  }

  .author-box-links a {
    color: var(--color-link);
    text-underline-offset: 2px;
  }

  .author-box-links a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
