---
const lang = (Astro.locals as Record<string, any>)?.starlightRoute?.lang ?? 'en';
---

<p class="author-byline not-content">
  {lang === 'fr'
    ? <span>Par <a href="https://www.linkedin.com/in/carrereolivier/" rel="noopener noreferrer">Olivier Carrère</a>, rédacteur technique · <a href="https://redaction-technique.org/" rel="noopener noreferrer">Blog ↗</a></span>
    : <span>By <a href="https://www.linkedin.com/in/carrereolivier/" rel="noopener noreferrer">Olivier Carrère</a>, technical writer · <a href="https://redaction-technique.org/" rel="noopener noreferrer">Blog ↗</a></span>
  }
</p>

<style>
  .author-byline {
    font-size: var(--sl-text-sm);
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }

  .author-byline a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .author-byline a:hover {
    color: var(--color-accent);
  }
</style>
