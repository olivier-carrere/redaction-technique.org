---
// Converted from the Mermaid `graph TD` in:
// src/content/docs/{en,fr}/formats/nufirewall-case-study.mdx (diagram #7)
import Flowchart from './Flowchart.astro';
import { DIAGRAM_TEXT } from './diagram-text.ts';

const lang = Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en';

const text = DIAGRAM_TEXT.NestedConrefChainDiagram[lang];

const copy = {
  en: {
    label: 'conref',
  },
  fr: {
    label: 'conref',
  },
}[lang];

const nodes = [
  { id: 'A', label: copy.label },
  { id: 'B', label: copy.label },
  { id: 'C', label: copy.label },
];

const edges = [
  { from: 'A', to: 'B' },
  { from: 'B', to: 'C' },
];
---

<Flowchart title={text.title} description={text.description} direction="TB" nodes={nodes} edges={edges} />
