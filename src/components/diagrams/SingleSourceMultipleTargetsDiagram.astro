---
// Converted from the Mermaid `graph TD` in:
// src/content/docs/{en,fr}/formats/modular-documentation.mdx (diagram #2)
import Flowchart from './Flowchart.astro';
import { DIAGRAM_TEXT } from './diagram-text.ts';

const lang = Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en';

const text = DIAGRAM_TEXT.SingleSourceMultipleTargetsDiagram[lang];

const copy = {
  en: {
    hub: 'DITA XML',
    items: ['PDF', 'Website', 'Word processor', 'JavaHelp', 'Windows help'],
  },
  fr: {
    hub: 'DITA XML',
    items: ['PDF', 'Site web', 'Traitement de texte', 'JavaHelp', 'Aide Windows'],
  },
}[lang];

const nodes = [
  { id: 'A', label: copy.hub, variant: 'accent' as const },
  ...copy.items.map((label, i) => ({ id: `I${i}`, label })),
];
const edges = copy.items.map((_, i) => ({ from: 'A', to: `I${i}` }));
---

<Flowchart title={text.title} description={text.description} direction="TB" nodes={nodes} edges={edges} />
