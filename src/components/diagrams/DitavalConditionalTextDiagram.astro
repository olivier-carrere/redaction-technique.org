---
// Converted from the Mermaid `graph TD` in:
// src/content/docs/{en,fr}/formats/nufirewall-case-study.mdx (diagram #10)
import Flowchart from './Flowchart.astro';
import { DIAGRAM_TEXT } from './diagram-text.ts';

const lang = Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en';

const text = DIAGRAM_TEXT.DitavalConditionalTextDiagram[lang];

const copy = {
  en: {
    source: 'Source',
    filter: 'ditaval filter',
    target1: 'Target 1',
    target2: 'Target 2',
  },
  fr: {
    source: 'Source',
    filter: 'filtre ditaval',
    target1: 'Cible 1',
    target2: 'Cible 2',
  },
}[lang];

const nodes = [
  { id: 'S', label: copy.source },
  { id: 'F', label: copy.filter, variant: 'accent' as const },
  { id: 'T1', label: copy.target1 },
  { id: 'T2', label: copy.target2 },
];

const edges = [
  { from: 'S', to: 'F' },
  { from: 'F', to: 'T1' },
  { from: 'F', to: 'T2' },
];
---

<Flowchart title={text.title} description={text.description} direction="TB" nodes={nodes} edges={edges} />
