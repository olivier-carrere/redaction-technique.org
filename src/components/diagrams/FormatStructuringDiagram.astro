---
// Converted from the Mermaid `graph TD` in:
// src/content/docs/{en,fr}/formats/index.mdx (diagram #0)
import Flowchart from './Flowchart.astro';
import { DIAGRAM_TEXT } from './diagram-text.ts';

const lang = Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en';

const text = DIAGRAM_TEXT.FormatStructuringDiagram[lang];

const copy = {
  en: {
    a: 'reStructuredText',
    b: 'FrameMaker',
    c: 'DocBook',
    d: 'DITA XML',
    edgeLabel: 'increasing structure',
  },
  fr: {
    a: 'reStructuredText',
    b: 'FrameMaker',
    c: 'DocBook',
    d: 'DITA XML',
    edgeLabel: 'structuration croissante',
  },
}[lang];

const nodes = [
  { id: 'A', label: copy.a },
  { id: 'B', label: copy.b },
  { id: 'C', label: copy.c },
  { id: 'D', label: copy.d },
];

const edges = [
  { from: 'A', to: 'B', label: copy.edgeLabel },
  { from: 'B', to: 'C', label: copy.edgeLabel },
  { from: 'C', to: 'D', label: copy.edgeLabel },
];
---

<Flowchart title={text.title} description={text.description} direction="TB" nodes={nodes} edges={edges} />
