---
// Converted from the Mermaid `graph TD` in:
// src/content/docs/{en,fr}/tutorials/project-end-to-end.mdx (diagram #0)
import Flowchart from './Flowchart.astro';
import { DIAGRAM_TEXT } from './diagram-text.ts';

const lang = Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en';

const text = DIAGRAM_TEXT.PhotoWorkflowDiagram[lang];

const copy = {
  en: {
    photographer: 'Photographer',
    iconographer: 'Iconographer',
    piwigo: 'Piwigo',
    git: 'Git repository',
    backup: 'Local backup',
    member: 'Non-profit member',
    designer: 'Graphic designer',
    upload: 'Upload',
    selection: 'Selection, classification, indexing',
    clone: 'Clone',
    search: 'Search, download',
  },
  fr: {
    photographer: 'Photographe',
    iconographer: 'Iconographe',
    piwigo: 'Piwigo',
    git: 'Dépôt Git',
    backup: 'Sauvegarde locale',
    member: "Membre de l'association",
    designer: 'Graphiste',
    upload: 'Upload',
    selection: 'Sélection, classement, indexation',
    clone: 'Clone',
    search: 'Recherche, téléchargement',
  },
}[lang];

const nodes = [
  { id: 'PHOTOGRAPHER', label: copy.photographer },
  { id: 'ICONOGRAPHER', label: copy.iconographer },
  { id: 'PIWIGO', label: copy.piwigo, variant: 'accent' as const },
  { id: 'GIT', label: copy.git },
  { id: 'BACKUP', label: copy.backup },
  { id: 'MEMBER', label: copy.member },
  { id: 'DESIGNER', label: copy.designer },
];

const edges = [
  { from: 'PHOTOGRAPHER', to: 'PIWIGO', label: copy.upload },
  { from: 'ICONOGRAPHER', to: 'PIWIGO', label: copy.selection },
  { from: 'PIWIGO', to: 'GIT' },
  { from: 'GIT', to: 'BACKUP' },
  { from: 'GIT', to: 'MEMBER', label: copy.clone },
  { from: 'PIWIGO', to: 'DESIGNER', label: copy.search },
];
---

<Flowchart title={text.title} description={text.description} direction="TB" nodes={nodes} edges={edges} />
