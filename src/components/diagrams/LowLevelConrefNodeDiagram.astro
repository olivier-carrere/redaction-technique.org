---
// Converted from the Mermaid `graph TD` in:
// src/content/docs/{en,fr}/formats/nufirewall-case-study.mdx (diagram #4)
import Flowchart from './Flowchart.astro';
import { DIAGRAM_TEXT } from './diagram-text.ts';

const lang = Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en';

const text = DIAGRAM_TEXT.LowLevelConrefNodeDiagram[lang];

const copy = {
  en: {
    source: 'cmd node (source)',
    target: 'cmd node (target)',
    edgeLabel: 'conref',
  },
  fr: {
    source: 'nœud cmd (source)',
    target: 'nœud cmd (cible)',
    edgeLabel: 'conref',
  },
}[lang];

const nodes = [
  { id: 'A', label: copy.source },
  { id: 'B', label: copy.target },
];

const edges = [{ from: 'A', to: 'B', label: copy.edgeLabel }];
---

<Flowchart title={text.title} description={text.description} direction="TB" nodes={nodes} edges={edges} />
