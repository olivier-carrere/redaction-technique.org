---
// Converted from the Mermaid `graph TD` in:
// src/content/docs/{en,fr}/formats/nufirewall-case-study.mdx (diagram #8)
// Source has no accDescr — description intentionally omitted, as in the original.
import Flowchart from './Flowchart.astro';
import { DIAGRAM_TEXT } from './diagram-text.ts';

const lang = Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en';

const text = DIAGRAM_TEXT.ModularConrefBlocksDiagram[lang];

const copy = {
  en: {
    groupMono: 'Monolithic source',
    groupMod: 'Modular source',
    content: 'Content',
    conref: 'conref',
  },
  fr: {
    groupMono: 'Source monolithique',
    groupMod: 'Source modulaire',
    content: 'Contenu',
    conref: 'conref',
  },
}[lang];

const nodes = [
  { id: 'M', label: copy.content },
  { id: 'C1', label: copy.conref },
  { id: 'C2', label: copy.conref },
  { id: 'C3', label: copy.conref },
];

const groups = [
  { id: 'mono', label: copy.groupMono, members: ['M'], direction: 'TB' as const },
  { id: 'mod', label: copy.groupMod, members: ['C1', 'C2', 'C3'], direction: 'TB' as const },
];
---

<Flowchart title={text.title} direction="TB" nodes={nodes} edges={[]} groups={groups} />
