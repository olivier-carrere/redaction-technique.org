---
// Converted from the Mermaid `gantt` in:
// src/content/docs/{en,fr}/tech-writing-process/validation-quality-control.mdx
import GanttChart from './GanttChart.astro';
import { DIAGRAM_TEXT } from './diagram-text.ts';

const lang = Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en';

const text = DIAGRAM_TEXT.SerialVsParallelValidationGantt[lang];

const copy = {
  en: {
    serial: 'Serial process',
    parallel: 'Parallel process',
    writing: 'Writing',
    validation: 'Validation',
    publication: 'Publication',
    continuousValidation: 'Continuous validation',
  },
  fr: {
    serial: 'Processus sériel',
    parallel: 'Processus parallèle',
    writing: 'Rédaction',
    validation: 'Validation',
    publication: 'Publication',
    continuousValidation: 'Validation continue',
  },
}[lang];

const sections = [
  {
    name: copy.serial,
    tasks: [
      { label: copy.writing, start: 0, duration: 1 },
      { label: copy.validation, start: 1, duration: 1 },
      { label: copy.publication, start: 2, duration: 1 },
    ],
  },
  {
    name: copy.parallel,
    tasks: [
      { label: copy.writing, start: 0, duration: 1 },
      { label: copy.continuousValidation, start: 0, duration: 1 },
      { label: copy.publication, start: 1, duration: 1 },
    ],
  },
];
---

<GanttChart title={text.title} description={text.description} sections={sections} />
