---
// Converted from the Mermaid `graph TD` in:
// src/content/docs/{en,fr}/formats/nufirewall-case-study.mdx (diagram #2)
import Flowchart from './Flowchart.astro';
import { DIAGRAM_TEXT } from './diagram-text.ts';

const lang = Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en';

const text = DIAGRAM_TEXT.DecentralizedConrefDiagram[lang];

const copy = {
  en: {
    d1: 'dita-1.dita',
    d2: 'dita-2.dita',
    d3: 'dita-3.dita',
  },
  fr: {
    d1: 'dita-1.dita',
    d2: 'dita-2.dita',
    d3: 'dita-3.dita',
  },
}[lang];

const nodes = [
  { id: 'D1', label: copy.d1 },
  { id: 'D2', label: copy.d2 },
  { id: 'D3', label: copy.d3 },
];

const edges = [
  { from: 'D1', to: 'D2' },
  { from: 'D2', to: 'D3' },
  { from: 'D3', to: 'D1' },
];
---

<Flowchart title={text.title} description={text.description} direction="TB" nodes={nodes} edges={edges} />
