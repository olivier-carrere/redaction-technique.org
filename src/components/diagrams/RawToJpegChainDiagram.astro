---
// Converted from the Mermaid `graph TD` in:
// src/content/docs/{en,fr}/formats/structured-vs-unstructured-formats.mdx (diagram #1)
import Flowchart from './Flowchart.astro';
import { DIAGRAM_TEXT } from './diagram-text.ts';

const lang = Astro.url.pathname.startsWith('/fr') ? 'fr' : 'en';

const text = DIAGRAM_TEXT.RawToJpegChainDiagram[lang];

const copy = {
  en: {
    a: 'RAW',
    b: 'TIFF',
    c: 'JPEG',
  },
  fr: {
    a: 'RAW',
    b: 'TIFF',
    c: 'JPEG',
  },
}[lang];

const nodes = [
  { id: 'A', label: copy.a },
  { id: 'B', label: copy.b },
  { id: 'C', label: copy.c },
];
const edges = [
  { from: 'A', to: 'B' },
  { from: 'B', to: 'C' },
];
---

<Flowchart title={text.title} description={text.description} direction="TB" nodes={nodes} edges={edges} />
