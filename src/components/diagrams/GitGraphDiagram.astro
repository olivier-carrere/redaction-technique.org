---
// Generic renderer for Git history diagrams on this site. Without
// `branches`, it draws a single linear commit trunk (the converted Mermaid
// `gitGraph` diagrams). With `branches`, it draws one lane per named
// branch: a commit's parent is the previous commit on its lane, or — for
// the first commit of a secondary lane — the latest preceding commit on
// lane 0 (the fork point). Each lane can end with a short note.
import DiagramFrame from './DiagramFrame.astro';

export type GitCommit = { id?: string; tag?: string; branch?: number };
export type GitBranch = { name: string; note?: string };

interface Props {
  title: string;
  description?: string;
  commits: GitCommit[];
  branches?: GitBranch[];
}

const { title, description, commits, branches } = Astro.props;

const DOT_R = 7;

// --- Linear trunk layout -------------------------------------------------
const SPACING = 130;
const PAD = 24;
const TRUNK_Y = 70;

// --- Branch lane layout ---------------------------------------------------
// Approximate glyph widths: 11px bold sans for branch names, 11px sans for
// notes. Used only to size the viewBox so nothing is clipped.
const LANE_PAD = 16;
const LANE_TOP = 38;
const LANE_GAP = 56;
const LANE_SPACING = 64;
const NAME_CHAR = 7;
const NOTE_CHAR = 6.3;
const PILL_H = 22;

const lanes = branches ?? [];
const pillWidth = lanes.length ? Math.max(...lanes.map((b) => b.name.length)) * NAME_CHAR + 16 : 0;
const laneX0 = LANE_PAD + pillWidth + 30;
const laneY = (lane: number) => LANE_TOP + lane * LANE_GAP;

const placed = commits.map((c, i) => ({ ...c, lane: c.branch ?? 0, x: laneX0 + i * LANE_SPACING }));
const edges = placed.flatMap((c, i) => {
  const earlier = placed.slice(0, i).reverse();
  const parent = earlier.find((p) => p.lane === c.lane) ?? (c.lane > 0 ? earlier.find((p) => p.lane === 0) : undefined);
  return parent ? [{ from: parent, to: c }] : [];
});
const laneEnds = lanes.map((b, lane) => {
  const last = [...placed].reverse().find((c) => c.lane === lane);
  return { ...b, lane, x: last ? last.x : laneX0 };
});

const viewWidth = branches
  ? Math.ceil(Math.max(...laneEnds.map((l) => l.x + DOT_R + 10 + (l.note ? l.note.length * NOTE_CHAR : 0)))) + LANE_PAD
  : (commits.length - 1) * SPACING + PAD * 2 + 40;
const viewHeight = branches ? laneY(lanes.length - 1) + 30 : 130;
---

<DiagramFrame title={title} description={description} width={viewWidth} height={viewHeight}>
  {branches ? (
    <g>
      {edges.map(({ from, to }) => {
        const fy = laneY(from.lane);
        const ty = laneY(to.lane);
        // Same lane: straight segment. Fork: leave the parent vertically,
        // then curve into the child's lane.
        const d = fy === ty ? `M ${from.x} ${fy} L ${to.x} ${ty}` : `M ${from.x} ${fy} Q ${from.x} ${ty} ${to.x} ${ty}`;
        return <path d={d} fill="none" class="diagram-git-trunk" />;
      })}
      {laneEnds.map((l) => {
        const y = laneY(l.lane);
        return (
          <g>
            <rect x={LANE_PAD} y={y - PILL_H / 2} width={pillWidth} height={PILL_H} rx="3" class="diagram-git-tag" />
            <text x={LANE_PAD + pillWidth / 2} y={y + 4} text-anchor="middle" class="diagram-git-tag-label">
              {l.name}
            </text>
            {l.note && (
              <text x={l.x + DOT_R + 10} y={y + 4} class="diagram-edge-label">
                {l.note}
              </text>
            )}
          </g>
        );
      })}
      {placed.map((c) => {
        const y = laneY(c.lane);
        return (
          <g>
            <circle cx={c.x} cy={y} r={DOT_R} class="diagram-git-commit" />
            {c.id && (
              <text x={c.x} y={y - DOT_R - 6} text-anchor="middle" class="diagram-git-commit-label">
                {c.id}
              </text>
            )}
          </g>
        );
      })}
    </g>
  ) : (
    <g>
      <line x1={PAD + 20} y1={TRUNK_Y} x2={viewWidth - PAD - 20} y2={TRUNK_Y} class="diagram-git-trunk" />
      {commits.map((c, i) => {
        const x = PAD + 20 + i * SPACING;
        return (
          <g>
            {c.tag && (
              <g>
                <rect x={x - 34} y={TRUNK_Y - 44} width="68" height="22" rx="3" class="diagram-git-tag" />
                <text x={x} y={TRUNK_Y - 29} text-anchor="middle" class="diagram-git-tag-label">
                  {c.tag}
                </text>
                <line x1={x} y1={TRUNK_Y - 22} x2={x} y2={TRUNK_Y - DOT_R} class="diagram-git-tag-stem" />
              </g>
            )}
            <circle cx={x} cy={TRUNK_Y} r={DOT_R} class="diagram-git-commit" />
            {c.id && (
              <text x={x} y={TRUNK_Y + 30} text-anchor="middle" class="diagram-git-commit-label">
                {c.id}
              </text>
            )}
          </g>
        );
      })}
    </g>
  )}
</DiagramFrame>
