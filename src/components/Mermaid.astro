---
// Client-side Mermaid rendering. mermaid.js is bundled by Vite from node_modules
// (no build-time headless browser) — the repo previously tried rehype-mermaid +
// playwright for build-time SVG rendering and reverted it. The diagram
// re-renders on Starlight's light/dark toggle (document.documentElement's
// data-theme attribute) and after view-transition navigation.
interface Props {
  code: string;
  // Opt-in fixed backdrop for diagrams whose fills use literal (non-theme-token)
  // colors and need a stable canvas behind them regardless of light/dark mode.
  background?: string;
}

const { code, background } = Astro.props;
const uid = "mermaid-" + Math.random().toString(36).slice(2, 10);
---

<div
  class="mermaid-diagram"
  id={uid}
  data-code={code}
  style={background ? `background:${background};border-radius:8px;padding:1rem;` : undefined}
></div>

<script>
  import mermaid from "mermaid";

  function currentTheme() {
    return document.documentElement.dataset.theme === "light" ? "default" : "dark";
  }

  // Mermaid's classDef/linkStyle grammar can't parse CSS var(), so diagram
  // source uses {{token}} placeholders resolved here against the site's
  // Starlight color tokens (src/styles/custom.css / props.css), per theme.
  const palettes = {
    dark: {
      parentFill: "#17264f",
      parentStroke: "#3369ff",
      parentText: "#b3c7ff",
      childFill: "#23262f",
      childStroke: "#555962",
      childText: "#edeef3",
      lineColor: "#888c96",
    },
    default: {
      parentFill: "#cfd4fc",
      parentStroke: "#3d50f5",
      parentText: "#0f1c8a",
      childFill: "#edeef3",
      childStroke: "#888c96",
      childText: "#23262f",
      lineColor: "#555962",
    },
  };

  function applyPalette(code, theme) {
    const palette = palettes[theme];
    return code.replace(/\{\{(\w+)\}\}/g, (match, key) => palette[key] ?? match);
  }

  // mermaid.render() isn't safe to call concurrently - overlapping calls
  // (even for different diagrams) can silently clobber each other with an
  // empty result. Two things create overlap here: astro:page-load fires on
  // the initial page load as well as on client-side transitions, so the
  // top-level renderAll() call below and the listener both fire for a first
  // visit; and a page with several diagrams fires one renderOne per element
  // with no serialization between them. Route every render through a single
  // promise chain so only one mermaid.render() call is ever in flight, and
  // skip a diagram already rendered for the current theme.
  const renderedTheme = new WeakMap();
  let queue = Promise.resolve();

  function renderOne(el) {
    queue = queue.then(async () => {
      try {
        const raw = el.dataset.code;
        if (!raw) return;
        const theme = currentTheme();
        if (renderedTheme.get(el) === theme) return;
        const code = applyPalette(raw, theme);
        mermaid.initialize({ startOnLoad: false, theme, securityLevel: "strict" });
        const { svg } = await mermaid.render(el.id + "-svg", code);
        renderedTheme.set(el, theme);
        el.innerHTML = svg;
      } catch (err) {
        console.error(`[Mermaid] Failed to render diagram (${el.id}):`, err);
      }
    });
  }

  function renderAll() {
    document.querySelectorAll(".mermaid-diagram").forEach(renderOne);
  }

  renderAll();
  document.addEventListener("astro:page-load", renderAll);
  new MutationObserver(renderAll).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>

<style>
  .mermaid-diagram {
    display: flex;
    justify-content: center;
    margin: 1.75rem 0;
  }
  .mermaid-diagram :global(svg) {
    max-width: 100%;
    height: auto;
  }
</style>
