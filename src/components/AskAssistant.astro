---
/**
 * AskAssistant.astro
 *
 * Client-side UI for the "Ask the documentation" AI assistant.
 * Renders a question form, sends the question to /api/ask,
 * and displays the answer with source links.
 *
 * Props:
 *   lang – 'en' (default) | 'fr'
 */

interface Props {
  lang?: 'en' | 'fr';
}

const { lang = 'en' } = Astro.props;

const ui = {
  en: {
    formLabel:      'Ask the documentation',
    inputLabel:     'Ask a question about the documentation',
    placeholder:    'How do I structure a DITA topic?',
    submitBtn:      'Ask',
    hint:           "The assistant answers from the site's documentation only. It does not use general knowledge.",
    loading:        'Searching the documentation\u2026',
    answerHeading:  'Answer',
    sourcesHeading: 'Sources',
    fallback:       'An unexpected error occurred.',
  },
  fr: {
    formLabel:      'Interroger la documentation',
    inputLabel:     'Posez une question sur la documentation',
    placeholder:    'Comment structurer un topic DITA\u00a0?',
    submitBtn:      'Interroger',
    hint:           "L\u2019assistant r\u00e9pond uniquement \u00e0 partir de la documentation disponible sur ce site. Il ne fait pas appel \u00e0 des connaissances g\u00e9n\u00e9rales.",
    loading:        'Recherche dans la documentation\u2026',
    answerHeading:  'R\u00e9ponse',
    sourcesHeading: 'Sources',
    fallback:       'Une erreur inattendue s\u2019est produite.',
  },
} as const;

const t = ui[lang];
---

<div class="ask-assistant" id="ask-assistant" data-lang={lang} data-fallback={t.fallback}>
  <form id="ask-form" class="ask-form" aria-label={t.formLabel}>
    <label for="ask-input" class="ask-label">
      {t.inputLabel}
    </label>
    <div class="ask-input-row">
      <input
        type="text"
        id="ask-input"
        name="question"
        class="ask-input"
        placeholder={t.placeholder}
        maxlength="500"
        autocomplete="off"
        required
      />
      <button type="submit" id="ask-submit" class="ask-button">
        {t.submitBtn}
      </button>
    </div>
    <p class="ask-hint">
      {t.hint}
    </p>
  </form>

  <div id="ask-loading" class="ask-loading" hidden>
    <span class="ask-spinner" aria-hidden="true"></span>
    {t.loading}
  </div>

  <div id="ask-error" class="ask-error" role="alert" hidden></div>

  <div id="ask-result" class="ask-result" hidden>
    <h2 class="ask-result-heading">{t.answerHeading}</h2>
    <div id="ask-answer" class="ask-answer"></div>

    <div id="ask-sources-section" hidden>
      <h3 class="ask-sources-heading">{t.sourcesHeading}</h3>
      <ul id="ask-sources" class="ask-sources"></ul>
    </div>
  </div>
</div>

<style>
  .ask-assistant {
    max-width: 42rem;
  }

  .ask-label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .ask-input-row {
    display: flex;
    gap: 0.5rem;
  }

  .ask-input {
    flex: 1;
    padding: 0.6rem 0.75rem;
    font-size: 1rem;
    font-family: inherit;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.375rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    transition: border-color 0.15s;
  }

  .ask-input:focus {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -1px;
    border-color: var(--sl-color-accent);
  }

  .ask-button {
    padding: 0.6rem 1.25rem;
    font-size: 1rem;
    font-family: inherit;
    font-weight: 600;
    border: none;
    border-radius: 0.375rem;
    background: var(--sl-color-accent);
    color: var(--sl-color-accent-text, #fff);
    cursor: pointer;
    transition: opacity 0.15s;
    white-space: nowrap;
  }

  .ask-button:hover {
    opacity: 0.85;
  }

  .ask-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ask-hint {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }

  /* Loading state */
  .ask-loading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    color: var(--sl-color-gray-2);
    font-size: 0.9375rem;
  }

  .ask-spinner {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--sl-color-gray-4);
    border-top-color: var(--sl-color-accent);
    border-radius: 50%;
    animation: ask-spin 0.7s linear infinite;
  }

  @keyframes ask-spin {
    to { transform: rotate(360deg); }
  }

  /* Error */
  .ask-error {
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    border-radius: 0.375rem;
    background: var(--sl-color-red-low, #fef2f2);
    color: var(--sl-color-red-high, #b91c1c);
    border: 1px solid var(--sl-color-red, #fca5a5);
    font-size: 0.9375rem;
  }

  /* Result */
  .ask-result {
    margin-top: 1.5rem;
  }

  .ask-result-heading {
    font-size: 1.125rem;
    margin-bottom: 0.75rem;
  }

  .ask-answer {
    line-height: 1.7;
  }

  /* Markdown-rendered answer content */
  .ask-answer p {
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .ask-answer p:last-child {
    margin-bottom: 0;
  }

  .ask-answer ul,
  .ask-answer ol {
    margin-top: 0.25rem;
    margin-bottom: 0.75rem;
    padding-left: 1.5rem;
  }

  .ask-answer li {
    margin-bottom: 0.25rem;
  }

  .ask-answer code {
    font-family: var(--sl-font-mono, monospace);
    font-size: 0.875em;
    background: var(--sl-color-gray-6, #f3f4f6);
    color: var(--sl-color-text, inherit);
    padding: 0.125em 0.35em;
    border-radius: 0.25rem;
  }

  .ask-answer strong {
    font-weight: 700;
  }

  .ask-answer em {
    font-style: italic;
  }

  .ask-answer a {
    color: var(--sl-color-accent);
    text-decoration: underline;
  }

  .ask-answer a:hover {
    text-decoration: none;
  }

  .ask-sources-heading {
    font-size: 1rem;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .ask-sources {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ask-sources li {
    padding: 0.25rem 0;
  }

  .ask-sources a {
    color: var(--sl-color-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .ask-sources a::before {
    content: '→ ';
    color: var(--sl-color-gray-3);
  }

  .ask-sources a:hover {
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 30rem) {
    .ask-input-row {
      flex-direction: column;
    }

    .ask-button {
      align-self: flex-end;
    }
  }
</style>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';

  // Configure marked: use synchronous mode, no async extensions.
  // gfm: GitHub-Flavored Markdown (tables, task lists, etc.)
  // breaks: treat single newlines as <br> (mirrors Gemini's line-break convention)
  marked.setOptions({ gfm: true, breaks: false });

  const container = document.getElementById('ask-assistant') as HTMLDivElement;
  const lang      = container?.dataset.lang ?? 'en';
  const fallback  = container?.dataset.fallback ?? 'An unexpected error occurred.';

  const form     = document.getElementById('ask-form') as HTMLFormElement;
  const input    = document.getElementById('ask-input') as HTMLInputElement;
  const submit   = document.getElementById('ask-submit') as HTMLButtonElement;
  const loading  = document.getElementById('ask-loading') as HTMLDivElement;
  const errorEl  = document.getElementById('ask-error') as HTMLDivElement;
  const resultEl = document.getElementById('ask-result') as HTMLDivElement;
  const answerEl = document.getElementById('ask-answer') as HTMLDivElement;
  const srcSect  = document.getElementById('ask-sources-section') as HTMLDivElement;
  const srcList  = document.getElementById('ask-sources') as HTMLUListElement;

  function hide(el: HTMLElement) { el.hidden = true; }
  function show(el: HTMLElement) { el.hidden = false; }

  /**
   * Render Markdown text to safe HTML.
   * marked converts Markdown → HTML; DOMPurify strips executable content.
   */
  function renderMarkdown(text: string): string {
    const rawHtml = marked.parse(text) as string;
    return DOMPurify.sanitize(rawHtml, {
      // Allow only safe presentational/structural elements.
      ALLOWED_TAGS: [
        'p', 'br', 'strong', 'em', 'b', 'i', 'code', 'pre',
        'ul', 'ol', 'li', 'blockquote',
        'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
        'a', 'hr',
      ],
      ALLOWED_ATTR: ['href', 'title', 'target', 'rel'],
      // Force all links to be safe: no javascript: or data: URIs.
      ALLOW_DATA_ATTR: false,
      FORCE_BODY: false,
    });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const question = input.value.trim();
    if (!question) return;

    // Reset UI
    hide(errorEl);
    hide(resultEl);
    show(loading);
    submit.disabled = true;

    try {
      const res = await fetch('/api/ask/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question, language: lang }),
      });

      const data = await res.json();

      if (!res.ok) {
        if (data.devDetails) {
          console.warn('[AskAssistant DEV]', data.devDetails);
        }
        throw new Error(data.error ?? `Server error (${res.status})`);
      }

      // Display answer — render Markdown, then sanitize before injecting.
      const rawAnswer = data.answer ?? '';
      answerEl.innerHTML = renderMarkdown(rawAnswer);
      show(resultEl);

      // Display sources — built via safe DOM APIs, not innerHTML.
      srcList.innerHTML = '';
      const sources: Array<{ title: string; url: string }> = data.sources ?? [];
      if (sources.length > 0) {
        for (const src of sources) {
          const li = document.createElement('li');
          const a  = document.createElement('a');
          a.href = src.url;
          a.textContent = src.title;
          li.appendChild(a);
          srcList.appendChild(li);
        }
        show(srcSect);
      } else {
        hide(srcSect);
      }
    } catch (err) {
      const message = err instanceof Error ? err.message : fallback;
      errorEl.textContent = message;
      show(errorEl);
    } finally {
      hide(loading);
      submit.disabled = false;
    }
  });
</script>

