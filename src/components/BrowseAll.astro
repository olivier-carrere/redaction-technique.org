---
import CardGridSection from './CardGridSection.astro';

interface Props {
  lang?: string;
}

const routeLang = (Astro.locals as Record<string, any>)?.starlightRoute?.lang;
const lang = Astro.props.lang || routeLang || 'en';
const isFr = lang === 'fr';
const base = isFr ? '/fr' : '/en';

const cards = isFr ? [
  { title: '1. Comprendre la documentation', href: `${base}/learn/`, desc: 'Valeur, maturité documentaire, communication technique et typologie de l’information.', linkText: 'Découvrir →' },
  { title: '2. Construire un processus documentaire', href: `${base}/process/`, desc: 'Planification, rédaction, révision, gouvernance et maintenance.', linkText: 'Découvrir →' },
  { title: '3. Adopter le docs-as-code', href: `${base}/docs-as-code/`, desc: 'Git, Markdown, pull requests, CI/CD et publication statique.', linkText: 'Découvrir →' },
  { title: '4. Choisir un modèle de rédaction', href: `${base}/tools-and-formats/`, desc: 'Markdown, rédaction structurée, DITA, réutilisation, formats source et cible.', linkText: 'Découvrir →' },
  { title: '5. Constituer votre boîte à outils', href: `${base}/toolkit/`, desc: 'Modèles, check-lists, exemples et workflows réutilisables.', linkText: 'Découvrir →' },
  { title: '6. Automatisation et techniques héritées', href: `${base}/tutorials/`, desc: 'Jinja, Python, sed, Sphinx/ReST, XSL-FO et Raspberry Pi.', linkText: 'Découvrir →' },
  { title: 'Explorer la référence', href: `${base}/reference/`, desc: 'Glossaire, concepts, commandes et détails techniques.', linkText: 'Découvrir →' },
] : [
  { title: '1. Understand documentation', href: `${base}/learn/`, desc: 'Value, documentation maturity, technical communication, and information types.', linkText: 'Explore →' },
  { title: '2. Build a documentation process', href: `${base}/process/`, desc: 'Planning, authoring, review, governance, and maintenance.', linkText: 'Explore →' },
  { title: '3. Adopt docs-as-code', href: `${base}/docs-as-code/`, desc: 'Git, Markdown, pull requests, CI/CD, and static publishing.', linkText: 'Explore →' },
  { title: '4. Choose an authoring model', href: `${base}/tools-and-formats/`, desc: 'Markdown, structured authoring, DITA, reuse, and source vs target formats.', linkText: 'Explore →' },
  { title: '5. Build your toolkit', href: `${base}/toolkit/`, desc: 'Templates, checklists, examples, and reusable workflows.', linkText: 'Explore →' },
  { title: '6. Automation & legacy techniques', href: `${base}/tutorials/`, desc: 'Jinja, Python, sed, Sphinx/ReST, XSL-FO, and Raspberry Pi.', linkText: 'Explore →' },
  { title: 'Explore the reference', href: `${base}/reference/`, desc: 'Glossary, concepts, commands, and technical details.', linkText: 'Explore →' },
];
---

<CardGridSection
  id="browse-all"
  kicker={isFr ? 'Parcourir la documentation' : 'Browse All'}
  title={isFr ? 'Parcourir toute la documentation' : 'Browse all documentation'}
  desc={isFr
    ? 'Vous savez ce que vous cherchez ? Six sections couvrent l’ensemble de la pratique documentaire, des fondamentaux aux techniques héritées, complétées par la référence.'
    : 'Already know what you’re looking for? Six sections cover the full spectrum of technical documentation, from foundations to legacy techniques, plus the reference.'}
  cards={cards}
  compact
/>
