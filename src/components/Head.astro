---
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';
import SpeedInsights from '@vercel/speed-insights/astro';
import type { Props } from '@astrojs/starlight/props';
import { getMarkdownUrl, hasMarkdownUrl } from '../lib/page-markdown';

// Starlight v0.35+: use Astro.locals.starlightRoute (Astro.props is deprecated)
const { entry, lang } = Astro.locals.starlightRoute;
const siteUrl = 'https://docs.redaction-technique.org';
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
const pathname = Astro.url.pathname;
const isHomepage = pathname === '/' || /^\/(en|fr)\/?$/.test(pathname);

// Root-only pages (404, /tag/*) have no /en/ or /fr/ counterpart: drop the
// hreflang alternates Starlight derives for them, which would 404. The 404
// page also gets no canonical, since /404/ is not a real route.
if (!/^\/(en|fr)(\/|$)/.test(pathname) && pathname !== '/') {
  const is404 = /^\/404(\.html|\/)?$/.test(pathname);
  Astro.locals.starlightRoute.head = Astro.locals.starlightRoute.head.filter(
    ({ tag, attrs }) =>
      !(tag === 'link' && (attrs?.hreflang || (is404 && attrs?.rel === 'canonical'))),
  );
}

const entryId = entry?.id;
const markdownUrl = hasMarkdownUrl(entryId)
  ? getMarkdownUrl(entryId)
  : (isHomepage ? (lang === 'fr' ? '/fr.md' : '/en.md') : null);
const markdownHref = markdownUrl ? `${siteUrl}${markdownUrl}` : null;

const siteName = 'Redaction-technique.org';
const defaultImage = `${siteUrl}/assets/opengraph.jpg`;
// Starlight already emits og:title, og:description, og:type, og:url, og:locale,
// og:site_name, and twitter:card - read data from the correct source for our additions.
const siteDefaultDescription = lang === 'fr'
  ? 'Manuel de rédaction technique par Olivier Carrère, rédacteur technique senior : processus documentaire, docs-as-code, DITA XML et rédaction structurée, automatisation documentaire.'
  : 'A technical writing manual by Olivier Carrère, senior technical writer: documentation process, docs-as-code, DITA XML and structured authoring, and documentation automation.';
const pageTitle = entry?.data?.title ?? siteName;
const pageDescription = entry?.data?.description || siteDefaultDescription;

const dateStr = entry?.data?.lastUpdated instanceof Date
  ? entry.data.lastUpdated.toISOString().slice(0, 10)
  : undefined;

// Same @id and profile URL as redaction-technique.org, the author's
// professional site, so both sites describe one Person entity.
const personId = 'https://redaction-technique.org/#olivier-carrere';

const personEntity = {
  '@type': 'Person',
  '@id': personId,
  name: 'Olivier Carrère',
  url: 'https://redaction-technique.org/about',
  jobTitle: lang === 'fr' ? 'Rédacteur technique senior' : 'Senior Technical Writer',
  // Areas evidenced by the /expertise/ page (src/lib/expertise.ts).
  knowsAbout: [
    'Technical writing',
    'Developer documentation',
    'API documentation',
    'Docs as code',
    'DITA',
    'Structured authoring',
    'Information architecture',
    'Documentation automation',
    'Continuous integration',
    'Localization',
  ],
  sameAs: [
    'https://www.linkedin.com/in/carrereolivier/',
    'https://github.com/olivier-carrere',
    'https://redaction-technique.org/',
  ],
};

const articleAbout = {
  '@type': 'Thing',
  name: lang === 'fr' ? 'Rédaction technique' : 'Technical Writing',
  sameAs: 'https://en.wikipedia.org/wiki/Technical_writing',
};

// BreadcrumbList derived from URL segments
const pathParts = pathname.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);
const localePrefix = (pathParts[0] === 'en' || pathParts[0] === 'fr') ? pathParts[0] : null;
const contentParts = localePrefix ? pathParts.slice(1) : pathParts;

type ListItem = { '@type': 'ListItem'; position: number; name: string; item: string };
const breadcrumbItems: ListItem[] = [];

if (!isHomepage && contentParts.length > 0) {
  const homeLabel = lang === 'fr' ? 'Accueil' : 'Home';
  const homeUrl = localePrefix ? `${siteUrl}/${localePrefix}/` : `${siteUrl}/`;
  breadcrumbItems.push({ '@type': 'ListItem', position: 1, name: homeLabel, item: homeUrl });

  let cumUrl = localePrefix ? `${siteUrl}/${localePrefix}` : siteUrl;
  contentParts.forEach((seg, idx) => {
    cumUrl += `/${seg}`;
    const isLast = idx === contentParts.length - 1;
    const label = isLast
      ? pageTitle
      : seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
    breadcrumbItems.push({ '@type': 'ListItem', position: idx + 2, name: label, item: `${cumUrl}/` });
  });
}

// Build a single @graph block per page for maximum validator compatibility
type SchemaNode = Record<string, unknown>;
let graphNodes: SchemaNode[];

if (isHomepage) {
  graphNodes = [
    { '@type': 'WebSite', '@id': `${siteUrl}/#website`, url: siteUrl, name: siteName, author: { '@id': personId } },
    personEntity,
  ];
} else if (entryId && /^(en|fr)\/about-this-blog$/.test(entryId)) {
  graphNodes = [
    {
      '@type': 'ProfilePage',
      name: pageTitle,
      description: pageDescription,
      url: currentUrl,
      inLanguage: lang,
      mainEntity: { '@id': personId },
    },
    personEntity,
  ];
} else if (entryId && /^(en|fr)\/expertise$/.test(entryId)) {
  graphNodes = [
    {
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      url: currentUrl,
      inLanguage: lang,
      about: { '@id': personId },
      author: { '@id': personId },
    },
    personEntity,
  ];
} else {
  const articleNode: SchemaNode = {
    '@type': 'TechArticle',
    headline: pageTitle,
    description: pageDescription,
    image: defaultImage,
    about: articleAbout,
    url: currentUrl,
    inLanguage: lang,
    author: { '@id': personId },
    publisher: { '@id': personId },
  };
  if (dateStr) {
    articleNode.datePublished = dateStr;
    articleNode.dateModified = dateStr;
  }
  graphNodes = [articleNode, personEntity];
}

// breadcrumbItems is empty on the homepage.
if (breadcrumbItems.length > 0) {
  graphNodes.push({ '@type': 'BreadcrumbList', itemListElement: breadcrumbItems });
}

const schema = { '@context': 'https://schema.org', '@graph': graphNodes };
---

<script is:inline>
  (function () {
    const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
    if (!stored) {
      document.documentElement.dataset.theme = 'light';
    }
  })();
</script>
<ClientRouter />
<Default {...Astro.props} />

<!-- og:image - not emitted by Starlight's default head -->
<meta property="og:image" content={defaultImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={pageTitle} />

<!-- Twitter / X Card - Starlight only sets twitter:card -->
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={defaultImage} />
<meta name="twitter:image:alt" content={pageTitle} />

<!-- Alternate Markdown representation for LLMs and automated tools -->
{markdownHref && (
  <link
    rel="alternate"
    type="text/markdown"
    title={lang === 'fr' ? 'Représentation Markdown pour LLM' : 'Markdown representation for LLM'}
    href={markdownHref}
  />
)}

<!-- Machine-readable document index discovery (JSON) -->
<link
  rel="alternate"
  type="application/json"
  title={lang === 'fr' ? 'Index documentaire machine-readable (JSON)' : 'Machine-readable document index (JSON)'}
  href={lang === 'fr' ? `${siteUrl}/fr/index.json` : `${siteUrl}/en/index.json`}
/>

<!-- LLM documentation index (llms.txt) -->
<link
  rel="alternate"
  type="text/plain"
  title="LLM documentation table of contents (llms.txt)"
  href={`${siteUrl}/llms.txt`}
/>

<!-- og:description: Starlight emits it only when the page has a description;
     fall back to the site default otherwise, without duplicating the tag. -->
{!entry?.data?.description && <meta property="og:description" content={pageDescription} />}

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<SpeedInsights />
