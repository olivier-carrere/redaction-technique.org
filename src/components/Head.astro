---
import Default from '@astrojs/starlight/components/Head.astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import type { Props } from '@astrojs/starlight/props';

// Starlight v0.35+: use Astro.locals.starlightRoute (Astro.props is deprecated)
const { entry, lang } = Astro.locals.starlightRoute;
const siteUrl = 'https://docs.redaction-technique.org';
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
const pathname = Astro.url.pathname;
const isHomepage = pathname === '/' || /^\/(en|fr)\/?$/.test(pathname);

// hreflang: derive alternate-locale URLs from current pathname
let enHref: string | null = null;
let frHref: string | null = null;
if (pathname === '/') {
  enHref = `${siteUrl}/en/`;
  frHref = `${siteUrl}/fr/`;
} else {
  const localeMatch = pathname.match(/^\/(en|fr)(\/.*)?$/);
  if (localeMatch) {
    const restPath = localeMatch[2] ?? '/';
    enHref = `${siteUrl}/en${restPath}`;
    frHref = `${siteUrl}/fr${restPath}`;
  }
}

const siteName = 'Redaction-technique.org';
const defaultImage = `${siteUrl}/assets/opengraph.jpg`;
// Starlight already emits og:title, og:description, og:type, og:url, og:locale,
// og:site_name, and twitter:card - read data from the correct source for our additions.
const siteDefaultDescription = lang === 'fr'
  ? 'Guides experts en rédaction technique, DITA XML, Markdown, docs-as-code et automatisation de contenu pour communicants techniques.'
  : 'Expert guides on technical writing, DITA XML, Markdown, docs-as-code, and content automation for technical communicators.';
const pageTitle = entry?.data?.title ?? siteName;
const pageDescription = entry?.data?.description || siteDefaultDescription;

const dateStr = entry?.data?.lastUpdated instanceof Date
  ? entry.data.lastUpdated.toISOString().slice(0, 10)
  : undefined;

const personId = `${siteUrl}/#olivier-carrere`;

const personEntity = {
  '@type': 'Person',
  '@id': personId,
  name: 'Olivier Carrère',
  url: 'https://redaction-technique.org',
  jobTitle: lang === 'fr' ? 'Rédacteur technique' : 'Technical Writer',
  sameAs: ['https://www.linkedin.com/in/carrereolivier/'],
};

const articleAbout = {
  '@type': 'Thing',
  name: lang === 'fr' ? 'Rédaction technique' : 'Technical Writing',
  sameAs: 'https://en.wikipedia.org/wiki/Technical_writing',
};

// BreadcrumbList derived from URL segments
const pathParts = pathname.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);
const localePrefix = (pathParts[0] === 'en' || pathParts[0] === 'fr') ? pathParts[0] : null;
const contentParts = localePrefix ? pathParts.slice(1) : pathParts;

type ListItem = { '@type': 'ListItem'; position: number; name: string; item: string };
const breadcrumbItems: ListItem[] = [];

if (!isHomepage && contentParts.length > 0) {
  const homeLabel = lang === 'fr' ? 'Accueil' : 'Home';
  const homeUrl = localePrefix ? `${siteUrl}/${localePrefix}/` : `${siteUrl}/`;
  breadcrumbItems.push({ '@type': 'ListItem', position: 1, name: homeLabel, item: homeUrl });

  let cumUrl = localePrefix ? `${siteUrl}/${localePrefix}` : siteUrl;
  contentParts.forEach((seg, idx) => {
    cumUrl += `/${seg}`;
    const isLast = idx === contentParts.length - 1;
    const label = isLast
      ? pageTitle
      : seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
    breadcrumbItems.push({ '@type': 'ListItem', position: idx + 2, name: label, item: `${cumUrl}/` });
  });
}

// Build a single @graph block per page for maximum validator compatibility
type SchemaNode = Record<string, unknown>;
let graphNodes: SchemaNode[];

if (isHomepage) {
  graphNodes = [
    { '@type': 'WebSite', '@id': `${siteUrl}/#website`, url: siteUrl, name: siteName, author: { '@id': personId } },
    personEntity,
  ];
} else {
  const articleNode: SchemaNode = {
    '@type': 'TechArticle',
    headline: pageTitle,
    description: pageDescription,
    image: defaultImage,
    about: articleAbout,
    url: currentUrl,
    inLanguage: lang,
    author: { '@id': personId },
    publisher: { '@id': personId },
  };
  if (dateStr) {
    articleNode.datePublished = dateStr;
    articleNode.dateModified = dateStr;
  }
  graphNodes = [articleNode, personEntity];
  if (breadcrumbItems.length > 0) {
    graphNodes.push({ '@type': 'BreadcrumbList', itemListElement: breadcrumbItems });
  }
}

const schema = { '@context': 'https://schema.org', '@graph': graphNodes };
---

<Default {...Astro.props} />

<!-- og:image - not emitted by Starlight's default head -->
<meta property="og:image" content={defaultImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={pageTitle} />

<!-- Twitter / X Card - Starlight only sets twitter:card -->
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={defaultImage} />
<meta name="twitter:image:alt" content={pageTitle} />

<!-- x-default points to EN; en/fr alternates already emitted by Starlight -->
{enHref && <link rel="alternate" hreflang="x-default" href={enHref} />}

<!-- og:description: ensure it's always populated with the page-specific value -->
<meta property="og:description" content={pageDescription} />

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<SpeedInsights />
