---
import Default from '@astrojs/starlight/components/Head.astro';
import type { Props } from '@astrojs/starlight/props';

const { entry, lang } = Astro.props as Props;
const siteUrl = 'https://docs.redaction-technique.org';
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
const pathname = Astro.url.pathname;
const isHomepage = pathname === '/' || /^\/(en|fr)\/?$/.test(pathname);

// hreflang: derive alternate-locale URLs from current pathname
const localeMatch = pathname.match(/^\/(en|fr)(\/.*)?$/);
const restPath = localeMatch ? (localeMatch[2] ?? '/') : null;
const enHref = restPath !== null ? `${siteUrl}/en${restPath}` : null;
const frHref = restPath !== null ? `${siteUrl}/fr${restPath}` : null;

const siteName = 'Redaction-technique.org';
const defaultImage = `${siteUrl}/assets/galerie-photo.jpg`;
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US';
const ogTitle = entry.data.title;
const ogDescription = entry.data.description ?? '';

const dateStr = entry.data.lastUpdated instanceof Date
  ? entry.data.lastUpdated.toISOString().slice(0, 10)
  : undefined;

const personId = `${siteUrl}/#olivier-carrere`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId,
  name: 'Olivier Carrère',
  url: 'https://redaction-technique.org',
  jobTitle: lang === 'fr' ? 'Rédacteur technique' : 'Technical Writer',
  sameAs: ['https://www.linkedin.com/in/carrereolivier/'],
};

const schema = isHomepage
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': `${siteUrl}/#website`,
        url: siteUrl,
        name: siteName,
        author: { '@id': personId },
      },
      personSchema,
    ]
  : {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: entry.data.title,
      description: ogDescription,
      url: currentUrl,
      inLanguage: lang,
      author: { '@id': personId },
      publisher: { '@id': personId },
      ...(dateStr && { datePublished: dateStr, dateModified: dateStr }),
    };
---

<Default {...Astro.props} />

<!-- Open Graph -->
<meta property="og:type" content={isHomepage ? 'website' : 'article'} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={currentUrl} />
<meta property="og:image" content={defaultImage} />
<meta property="og:image:width" content="680" />
<meta property="og:image:height" content="451" />
<meta property="og:image:alt" content={ogTitle} />
<meta property="og:locale" content={ogLocale} />

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={defaultImage} />
<meta name="twitter:image:alt" content={ogTitle} />

<!-- hreflang -->
{enHref && frHref && (
  <>
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="fr" href={frHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
  </>
)}

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
