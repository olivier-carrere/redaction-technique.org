---
// Shared card-grid section used on the homepage (task chooser, practical
// resources). Styling uses existing design tokens only.
//
// Each card is a list item with a native heading; the heading's link is
// stretched over the card so the whole card is clickable while the link
// text stays just the card title. The visible action label repeats the
// link and is hidden from assistive technology. Optional slot content is
// rendered below the grid (for example, a line of secondary links).
interface Card {
  title: string;
  href: string;
  desc: string;
  count?: string;
  linkText: string;
}

interface Props {
  kicker: string;
  title: string;
  desc?: string;
  cards: Card[];
  id?: string;
  compact?: boolean;
}

const { kicker, title, desc, cards, id, compact = false } = Astro.props;
---

<section class="card-grid-panel not-content" id={id} aria-labelledby={id ? `${id}-heading` : undefined}>
  <div class="card-grid-header">
    <p class="card-grid-kicker">{kicker}</p>
    <h2 id={id ? `${id}-heading` : undefined} class="card-grid-title">{title}</h2>
    {desc && <p class="card-grid-desc">{desc}</p>}
  </div>

  <ul class:list={['card-grid-grid', { compact }]}>
    {cards.map((card) => (
      <li class="card-grid-card">
        <div class="card-grid-card-top">
          <h3 class="card-grid-card-title"><a href={card.href}>{card.title}</a></h3>
          {card.count && <span class="card-grid-card-count">{card.count}</span>}
        </div>
        <p class="card-grid-card-desc">{card.desc}</p>
        <span class="card-grid-card-link-text" aria-hidden="true">{card.linkText}</span>
      </li>
    ))}
  </ul>
  {Astro.slots.has('default') && <div class="card-grid-footer"><slot /></div>}
</section>

<style>
  .card-grid-footer {
    margin-top: 1rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .card-grid-footer :global(p) {
    margin: 0;
  }

  .card-grid-footer :global(a) {
    color: var(--color-link);
    font-weight: 500;
  }

  .card-grid-panel {
    margin: 3.5rem 0 2rem 0;
    padding: 1.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .card-grid-header {
    margin-bottom: 1.25rem;
  }

  .card-grid-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin: 0 0 0.35rem 0;
  }

  .card-grid-title {
    font-size: clamp(1.25rem, calc(1rem + 1vw), 1.6rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.25;
    margin: 0 0 0.5rem 0;
  }

  .card-grid-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .card-grid-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 48rem) {
    .card-grid-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .card-grid-grid.compact {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .card-grid-card {
    position: relative;
    margin: 0;
    display: flex;
    flex-direction: column;
    padding: 1rem 1.15rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .card-grid-card:hover {
    border-color: var(--color-accent);
  }

  .card-grid-card:has(a:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .card-grid-card-title a:focus-visible {
    outline: none;
  }

  .card-grid-card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .card-grid-card-title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
  }

  .card-grid-card-title a {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Stretch the title link over the whole card. */
  .card-grid-card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card-grid-card:hover .card-grid-card-title a {
    color: var(--color-link);
  }

  .card-grid-card-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-accent);
    flex-shrink: 0;
  }

  .card-grid-card-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.45;
    margin: 0 0 0.75rem 0;
    flex: 1;
  }

  .card-grid-card-link-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-link);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  @media (max-width: 40rem) {
    .card-grid-panel {
      padding: 1.25rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-grid-card {
      transition: none !important;
    }
  }
</style>
