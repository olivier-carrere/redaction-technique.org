---
// Shared card-grid section used by the homepage BrowseAll summary and by
// each of the 7 goal-based landing pages, so both share one visual system
// instead of two hand-rolled grids. Styling lifted from the original
// BrowseAll.astro (--sl-* tokens only, no new design tokens).
interface Card {
  title: string;
  href: string;
  desc: string;
  count?: string;
  linkText: string;
}

interface Props {
  kicker: string;
  title: string;
  desc?: string;
  cards: Card[];
  id?: string;
  compact?: boolean;
}

const { kicker, title, desc, cards, id, compact = false } = Astro.props;
---

<section class="card-grid-panel not-content" id={id} aria-labelledby={id ? `${id}-heading` : undefined}>
  <div class="card-grid-header">
    <span class="card-grid-kicker">{kicker}</span>
    <h2 id={id ? `${id}-heading` : undefined} class="card-grid-title">{title}</h2>
    {desc && <p class="card-grid-desc">{desc}</p>}
  </div>

  <div class:list={['card-grid-grid', { compact }]}>
    {cards.map((card) => (
      <a href={card.href} class="card-grid-card">
        <div class="card-grid-card-top">
          <span class="card-grid-card-title">{card.title}</span>
          {card.count && <span class="card-grid-card-count">{card.count}</span>}
        </div>
        <p class="card-grid-card-desc">{card.desc}</p>
        <span class="card-grid-card-link-text">{card.linkText}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .card-grid-panel {
    margin: 4rem 0 2rem 0;
    padding: 2rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
  }

  .card-grid-header {
    margin-bottom: 1.5rem;
  }

  .card-grid-kicker {
    display: inline-block;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--sl-color-accent-high);
    margin-bottom: 0.35rem;
  }

  .card-grid-title {
    font-size: clamp(1.25rem, calc(1rem + 1vw), 1.6rem);
    font-weight: 600;
    color: var(--sl-color-white);
    line-height: 1.25;
    margin: 0 0 0.5rem 0;
  }

  .card-grid-desc {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    margin: 0;
    line-height: 1.5;
  }

  .card-grid-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .card-grid-grid {
      grid-template-columns: 1fr 1fr;
    }
    .card-grid-grid.compact {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .card-grid-card {
    display: flex;
    flex-direction: column;
    padding: 1.15rem 1.25rem;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .card-grid-card:hover {
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    border-color: var(--sl-color-gray-3);
  }

  .card-grid-card:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .card-grid-card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .card-grid-card-title {
    font-size: var(--sl-text-base);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .card-grid-card:hover .card-grid-card-title {
    color: var(--sl-color-accent-high);
  }

  .card-grid-card-count {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    padding: 0.1rem 0.4rem;
    border-radius: 0.25rem;
    border: 1px solid var(--sl-color-accent);
    flex-shrink: 0;
  }

  .card-grid-card-desc {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.45;
    margin: 0 0 0.75rem 0;
    flex: 1;
  }

  .card-grid-card-link-text {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-accent-high);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  @media (max-width: 40rem) {
    .card-grid-panel {
      padding: 1.25rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-grid-card {
      transition: none !important;
    }
  }
</style>
